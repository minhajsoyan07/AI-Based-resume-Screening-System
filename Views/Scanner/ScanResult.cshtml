@model AIResumeScreeningSystem.Models.ResumeMatchResult
@{
    ViewData["Title"] = "ResuMatch | Scan Results";
    Layout = "_Layout";
    
    var scoreClass = Model.MatchScore >= 80 ? "#34d399" : (Model.MatchScore >= 50 ? "#fbbf24" : "#f87171");
    var scoreBg = Model.MatchScore >= 80 ? "rgba(52, 211, 153, 0.1)" : (Model.MatchScore >= 50 ? "rgba(251, 191, 36, 0.1)" : "rgba(248, 113, 113, 0.1)");
}

<style>
    :root {
        --ai-bg-dark: #0a0a0f;
        --ai-card-bg: rgba(255, 255, 255, 0.03);
        --ai-card-border: rgba(255, 255, 255, 0.08);
        --ai-text-main: #f8fafc;
        --ai-text-muted: #94a3b8;
    }

    body {
        background-color: var(--ai-bg-dark);
        color: var(--ai-text-main);
        font-family: 'Inter', sans-serif;
        background-image: 
            radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.1), transparent 50%);
        background-attachment: fixed;
    }

    .navbar { background: rgba(10, 10, 15, 0.8) !important; backdrop-filter: blur(10px); border-bottom: 1px solid var(--ai-card-border); }
    .navbar * { color: var(--ai-text-main) !important; }
    .sidebar { display: none !important; }
    .main-content { margin-left: 0 !important; background: transparent !important; padding-top: 2rem; }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        animation: fadeInDown 0.5s ease-out;
    }

    .ai-card {
        background: var(--ai-card-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--ai-card-border);
        border-radius: 20px;
        padding: 2rem;
        height: 100%;
        animation: fadeInUp 0.6s ease-out;
    }

    .score-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: 800;
        margin: 0 auto 1.5rem auto;
        border: 4px solid @scoreClass;
        background: @scoreBg;
        color: @scoreClass;
        box-shadow: 0 0 30px @scoreBg;
    }

    .section-title {
        color: var(--ai-text-main);
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ai-summary {
        color: var(--ai-text-muted);
        line-height: 1.7;
        font-size: 1.05rem;
    }

    .skill-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--ai-card-border);
        color: var(--ai-text-main);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    
    .skill-badge.matched {
        background: rgba(52, 211, 153, 0.1);
        border-color: rgba(52, 211, 153, 0.3);
        color: #34d399;
    }

    .skill-badge.missing {
        background: rgba(248, 113, 113, 0.1);
        border-color: rgba(248, 113, 113, 0.3);
        color: #f87171;
    }

    .btn-ai-outline {
        background: transparent;
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.5);
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-ai-outline:hover {
        background: rgba(99, 102, 241, 0.1);
        border-color: #a5b4fc;
        color: #fff;
    }

    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<div class="container" style="max-width: 1000px;">
    <div class="result-header">
        <h2 style="font-weight: 700; margin: 0;">Analysis Complete</h2>
        <a href="/Scanner/Dashboard" class="btn-ai-outline">Scan Another Resume</a>
    </div>

    <!-- AI Model & Provider Badge -->
    <div style="margin-bottom: 2rem; display: flex; justify-content: flex-end; gap: 1rem; align-items: center;">
        <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.1)); border: 1px solid rgba(99, 102, 241, 0.3); padding: 0.75rem 1.25rem; border-radius: 10px; font-size: 0.9rem; color: #a5b4fc; display: flex; align-items: center; gap: 0.75rem; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span style="color: #94a3b8;">Powered by:</span>
            <strong style="color: #e0e7ff; font-weight: 600;" id="aiModel">@(ViewBag.AIModel ?? "gemini-2.0-flash")</strong>
            <span style="color: #64748b; opacity: 0.6;">•</span>
            <strong style="color: #e0e7ff; font-weight: 600;" id="aiProvider">@(ViewBag.AIProvider ?? "Gemini")</strong>
        </div>
    </div>



    @{
        bool isRejected = Model.MatchScore == 0 || (Model.Verdict != null && Model.Verdict.StartsWith("Rejected"));
        bool isServiceError = Model.Verdict != null && Model.Verdict.Contains("temporarily unavailable");
    }

    @if (isServiceError)
    {
        <div style="background: rgba(251, 191, 36, 0.07); border: 1px solid rgba(251, 191, 36, 0.3); padding: 1.25rem 1.5rem; border-radius: 16px; margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 1rem; animation: fadeInUp 0.5s ease-out;">
            <div style="background: rgba(251, 191, 36, 0.2); width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #fbbf24;">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <div>
                <h6 style="color: #fbbf24; margin: 0 0 0.25rem 0; font-weight: 600;">⚠ AI Service Unavailable</h6>
                <p style="color: #94a3b8; margin: 0; font-size: 0.9rem;">The AI engine could not process your scan — this is a <strong style="color:#fbbf24;">technical error, not a reflection of your resume</strong>. Your credits have been refunded. Please try again shortly.</p>
            </div>
        </div>
    }
    else if (isRejected)
    {
        <div style="background: rgba(248, 113, 113, 0.07); border: 1px solid rgba(248, 113, 113, 0.3); padding: 1.25rem 1.5rem; border-radius: 16px; margin-bottom: 1.5rem; display: flex; align-items: flex-start; gap: 1rem; animation: fadeInUp 0.5s ease-out;">
            <div style="background: rgba(248, 113, 113, 0.2); width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #f87171;">
                <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
                <h6 style="color: #f87171; margin: 0 0 0.25rem 0; font-weight: 600;">❌ Not Qualified / Invalid Submission</h6>
                <p style="color: #94a3b8; margin: 0; font-size: 0.9rem;">@Model.Verdict</p>
            </div>
        </div>

        @* ── Hard Requirements Breakdown Table ── *@
        @if (!string.IsNullOrEmpty(Model.RequiredDegree) || Model.RequiredExperienceYears > 0 || !string.IsNullOrEmpty(Model.RequiredSubject))
        {
            <div class="ai-card" style="margin-bottom: 1.5rem; border-top: 3px solid #f87171; animation-delay: 0.1s;">
                <div class="section-title" style="color: #f87171; margin-bottom: 1.25rem;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                    Hard Requirements Breakdown
                </div>
                <div style="overflow-x:auto;">
                    <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
                        <thead>
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <th style="text-align:left; padding:0.6rem 1rem; color:#94a3b8; font-weight:600;">Requirement</th>
                                <th style="text-align:left; padding:0.6rem 1rem; color:#94a3b8; font-weight:600;">Job Requires</th>
                                <th style="text-align:left; padding:0.6rem 1rem; color:#94a3b8; font-weight:600;">Your Profile</th>
                                <th style="text-align:center; padding:0.6rem 1rem; color:#94a3b8; font-weight:600;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!string.IsNullOrEmpty(Model.RequiredDegree))
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                    <td style="padding:0.75rem 1rem; color:#f8fafc; font-weight:500;">
                                        <svg width="14" height="14" fill="none" stroke="#a5b4fc" viewBox="0 0 24 24" stroke-width="2" style="margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422A12.083 12.083 0 0121 12c0 5.523-4.477 10-9 10S3 17.523 3 12a12.083 12.083 0 012.84-7.722L12 14z"></path></svg>
                                        Degree Level
                                    </td>
                                    <td style="padding:0.75rem 1rem; color:#a5b4fc;">@Model.RequiredDegree</td>
                                    <td style="padding:0.75rem 1rem; color:@(Model.EducationMet ? "#34d399" : "#f87171");">
                                        @(string.IsNullOrEmpty(Model.CandidateDegree) ? "Not specified" : Model.CandidateDegree)
                                    </td>
                                    <td style="padding:0.75rem 1rem; text-align:center;">
                                        @if (Model.EducationMet)
                                        {
                                            <span style="background:rgba(52,211,153,0.15);color:#34d399;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✓ Pass</span>
                                        }
                                        else
                                        {
                                            <span style="background:rgba(248,113,113,0.15);color:#f87171;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✗ Fail</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(Model.RequiredSubject) && Model.RequiredSubject != "Any" && Model.RequiredSubject != "None")
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                    <td style="padding:0.75rem 1rem; color:#f8fafc; font-weight:500;">
                                        <svg width="14" height="14" fill="none" stroke="#a5b4fc" viewBox="0 0 24 24" stroke-width="2" style="margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                                        Subject / Major
                                    </td>
                                    <td style="padding:0.75rem 1rem; color:#a5b4fc;">@Model.RequiredSubject</td>
                                    <td style="padding:0.75rem 1rem; color:@(Model.SubjectMet ? "#34d399" : "#f87171");">
                                        @(string.IsNullOrEmpty(Model.CandidateSubject) ? "Not specified" : Model.CandidateSubject)
                                    </td>
                                    <td style="padding:0.75rem 1rem; text-align:center;">
                                        @if (Model.SubjectMet)
                                        {
                                            <span style="background:rgba(52,211,153,0.15);color:#34d399;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✓ Pass</span>
                                        }
                                        else
                                        {
                                            <span style="background:rgba(248,113,113,0.15);color:#f87171;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✗ Fail</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (Model.RequiredExperienceYears > 0)
                            {
                                <tr>
                                    <td style="padding:0.75rem 1rem; color:#f8fafc; font-weight:500;">
                                        <svg width="14" height="14" fill="none" stroke="#a5b4fc" viewBox="0 0 24 24" stroke-width="2" style="margin-right:6px;"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                        Experience
                                    </td>
                                    <td style="padding:0.75rem 1rem; color:#a5b4fc;">@Model.RequiredExperienceYears year@(Model.RequiredExperienceYears != 1 ? "s" : "")</td>
                                    <td style="padding:0.75rem 1rem; color:@(Model.ExperienceMet ? "#34d399" : "#f87171");">
                                        @Model.CandidateExperienceYears year@(Model.CandidateExperienceYears != 1 ? "s" : "")
                                    </td>
                                    <td style="padding:0.75rem 1rem; text-align:center;">
                                        @if (Model.ExperienceMet)
                                        {
                                            <span style="background:rgba(52,211,153,0.15);color:#34d399;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✓ Pass</span>
                                        }
                                        else
                                        {
                                            <span style="background:rgba(248,113,113,0.15);color:#f87171;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.8rem;font-weight:600;">✗ Fail</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div style="background: rgba(52, 211, 153, 0.07); border: 1px solid rgba(52, 211, 153, 0.3); padding: 1rem 1.5rem; border-radius: 16px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; animation: fadeInUp 0.5s ease-out;">
            <div style="background: rgba(52, 211, 153, 0.2); width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #34d399;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <p style="color: #34d399; margin: 0; font-weight: 600;">✅ @Model.Verdict</p>
        </div>
    }



    @if (ViewBag.Credits != null && (int)ViewBag.Credits < 2)
    {
        <div style="background: rgba(251, 191, 36, 0.05); border: 1px solid rgba(251, 191, 36, 0.2); padding: 1.25rem 1.5rem; border-radius: 20px; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; animation: fadeInUp 0.5s ease-out;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="background: rgba(251, 191, 36, 0.2); width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #fbbf24;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <div>
                    <h6 style="color: #fbbf24; margin: 0; font-weight: 600;">Low Credits Remaining</h6>
                    <p style="color: var(--ai-text-muted); margin: 0.1rem 0 0 0; font-size: 0.9rem;">Remaining: @ViewBag.Credits. You need at least 2 credits for your next scan.</p>
                </div>
            </div>
            <a href="/Credits/Index" class="btn-ai-outline" style="border-color: rgba(251, 191, 36, 0.4); color: #fbbf24; padding: 0.5rem 1rem; font-size: 0.9rem;">
                Buy More
            </a>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- Score Card -->
        <div class="col-md-4">
            <div class="ai-card text-center" style="display: flex; flex-direction: column; justify-content: center;">
                <h5 style="color: var(--ai-text-muted); font-weight: 600; margin-bottom: 2rem;">Match Score</h5>
                <div class="score-circle">
                    @Model.MatchScore%
                </div>
                <p style="color: var(--ai-text-muted); font-size: 0.9rem;">
                    Based on semantic alignment and keyword extraction.
                </p>
            </div>
        </div>

        <!-- Strengths & Recommendation Card -->
        <div class="col-md-8">
            <div class="ai-card">
                <div class="section-title">
                    <svg width="20" height="20" fill="none" stroke="#a5b4fc" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Strengths
                </div>
                <p class="ai-summary" style="margin-bottom: 1.5rem;">
                    @Model.Strengths
                </p>
                <div class="section-title" style="margin-top: 0.5rem;">
                    <svg width="20" height="20" fill="none" stroke="#818cf8" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    Recommendation
                </div>
                <p class="ai-summary">
                    @Model.Recommendation
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Core Skill Match -->
        <div class="col-md-6">
            <div class="ai-card" style="border-top: 3px solid #34d399;">
                <div class="section-title" style="color: #34d399;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Core Skill Match
                </div>
                @if (Model.CoreSkillMatch != null && Model.CoreSkillMatch.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.CoreSkillMatch)
                        {
                            <span class="skill-badge matched">@skill</span>
                        }
                    </div>
                }
                else
                {
                    <p style="color: var(--ai-text-muted); margin: 0;">No matching skills detected.</p>
                }
            </div>
        </div>

        <!-- Missing Skills -->
        <div class="col-md-6">
            <div class="ai-card" style="border-top: 3px solid #f87171;">
                <div class="section-title" style="color: #f87171;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Missing Skills
                </div>
                @if (Model.MissingSkills != null && Model.MissingSkills.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.MissingSkills)
                        {
                            <span class="skill-badge missing">@skill</span>
                        }
                    </div>
                }
                else
                {
                    <p style="color: var(--ai-text-muted); margin: 0;">No major missing skills identified.</p>
                }
            </div>
        </div>
    </div>
</div>
