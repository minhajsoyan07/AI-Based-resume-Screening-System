@model List<AIResumeScreeningSystem.DTOs.CandidateViewModel>
@{ 
    ViewData["Title"] = "Candidates";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
}

<div class="r-page-header-row" style="margin-bottom: 1rem;">
    <div>
        <h1 style="font-size:1.5rem; font-weight:800; color:#1A202C; margin:0 0 0.25rem;">Candidate Pipeline</h1>
        <p style="color:#777; margin:0; font-size:0.9rem;">Ranked by Match Score — @(ViewBag.JobTitle ?? "All Jobs")</p>
    </div>
    <div style="display:flex; gap:0.5rem;">
        <button type="submit" form="bulkActionsForm" asp-action="RunAnalysis" class="r-btn r-btn-primary" style="background:linear-gradient(135deg, #006B4D, #10B981); padding: 0.5rem 1rem;">⚡ Refresh Analysis</button>
    </div>
</div>

<!-- Filter Bar -->
<div class="r-card" style="padding:0.75rem 1.25rem; margin-bottom:1rem;">
    <div style="display:flex; gap:1rem; align-items:center; flex-wrap:wrap;">
        <div style="flex:1; min-width:240px;">
            <form method="get" asp-action="Candidates">
                <input type="hidden" name="jobId" value="@ViewBag.JobId"/>
                <input type="text" name="search" class="r-form-control" placeholder="🔍 Search by name, email or skills..." value="@ViewBag.SearchFilter" style="padding:0.65rem 1rem;"/>
            </form>
        </div>
        <div style="margin-left:auto;">
            <form method="get" asp-action="Candidates">
                <input type="hidden" name="jobId" value="@ViewBag.JobId"/>
                <select name="sort" class="r-form-control" style="width:auto; padding:0.6rem 1rem;" onchange="this.form.submit()">
                    <option value="ScoreDesc" selected="@(ViewBag.SortFilter == "ScoreDesc")">Top Match First</option>
                    <option value="Newest" selected="@(ViewBag.SortFilter == "Newest")">Newest First</option>
                    <option value="SkillDesc" selected="@(ViewBag.SortFilter == "SkillDesc")">Highest Skills</option>
                </select>
            </form>
        </div>
    </div>
</div>

<form method="post" id="bulkActionsForm">
    <input type="hidden" name="jobId" value="@ViewBag.JobId"/>

    <!-- Pipeline Stage Tabs -->
    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; overflow-x:auto; padding-bottom:0.25rem; align-items:center;">
        @{
            var columns = new[] {
                new { Title = "Applied", Status = "Applied", Color = "#3B82F6", Bg = "#EFF6FF" },
                new { Title = "Screening", Status = "UnderReview", Color = "#F59E0B", Bg = "#FFFBEB" },
                new { Title = "Shortlisted", Status = "Shortlisted", Color = "#10B981", Bg = "#ECFDF5" },
                new { Title = "Interview", Status = "InterviewScheduled", Color = "#8B5CF6", Bg = "#F5F3FF" },
                new { Title = "Hired", Status = "Hired", Color = "#059669", Bg = "#D1FAE5" },
                new { Title = "Rejected", Status = "Rejected", Color = "#EF4444", Bg = "#FEF2F2" }
            };
        }
        
        <div style="display:flex; gap:0.5rem;">
            <button type="submit" asp-action="BulkShortlist" class="r-btn" style="background:#ECFDF5; color:#047857; border:1px solid #A7F3D0; font-weight:700; padding:0.4rem 1rem;">✓ Shortlist</button>
            <button type="submit" asp-action="BulkReject" class="r-btn" style="background:#FEF2F2; color:#B91C1C; border:1px solid #FECACA; font-weight:700; padding:0.4rem 1rem;">✕ Reject</button>
        </div>

        <div style="margin-left:auto; display:flex; align-items:center; gap:0.5rem;">
            <input type="checkbox" id="selectAll" style="width:16px; height:16px; accent-color:#006B4D;"/>
            <label for="selectAll" style="font-size:0.8rem; color:#666; font-weight:600; cursor:pointer; user-select:none;">Select All</label>
        </div>
    </div>

    <!-- Stage filter pills -->
    <div style="display:flex; gap:0.5rem; margin-bottom:1rem; overflow-x:auto; flex-wrap:nowrap; padding: 0.2rem;">
        @foreach (var col in columns)
        {
            var count = Model.Count(c => c.ApplicationStatus == col.Status || (col.Status == "InterviewScheduled" && c.ApplicationStatus == "InterviewCompleted") || (col.Status == "Hired" && (c.ApplicationStatus == "OfferSent" || c.ApplicationStatus == "Accepted")));
            <button type="button"
                class="filter-stage-btn @(col.Status == "Applied" ? "active-stage" : "")"
                data-status="@col.Status"
                style="background:@(col.Status == "Applied" ? col.Color : col.Bg); color:@(col.Status == "Applied" ? "#fff" : col.Color); border:1.5px solid @col.Color; border-radius:2px; padding:0.5rem 1.25rem; font-size:0.82rem; font-weight:700; cursor:pointer; white-space:nowrap; transition:all 0.2s; box-shadow:none;">
                @col.Title <span style="opacity:0.75; font-weight:500;">(@count)</span>
            </button>
        }
    </div>

    <!-- Candidates List -->
    <div style="display:grid; gap:0.6rem;" id="candidatesList">
        @if (!Model.Any())
        {
            <div class="r-card" style="text-align:center; padding:4rem 2rem;">
                <div style="font-size:3.5rem; margin-bottom:1rem;">🔍</div>
                <h3 style="color:#1A202C; margin:0 0 0.5rem; font-size:1.25rem; font-weight:700;">No candidates found</h3>
                <p style="color:#777; margin:0;">Adjust your filters or wait for new applications.</p>
            </div>
        }
        @foreach (var c in Model)
        {
            var groupStatus = c.ApplicationStatus;
            if (c.ApplicationStatus == "InterviewCompleted") groupStatus = "InterviewScheduled";
            if (c.ApplicationStatus == "OfferSent" || c.ApplicationStatus == "Accepted") groupStatus = "Hired";
            
            var scoreColor = c.MatchScore >= 75 ? "#10B981" : c.MatchScore >= 50 ? "#3B82F6" : "#F59E0B";
            var scoreBg = c.MatchScore >= 75 ? "#ECFDF5" : c.MatchScore >= 50 ? "#EFF6FF" : "#FFFBEB";

            <div class="r-card candidate-item status-group-@groupStatus @(groupStatus == "Applied" ? "" : "cand-hidden")"
                 style="display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; gap:1rem; transition: transform 0.2s;">
                
                <div style="display:flex; gap:1.25rem; align-items:center; flex:1; min-width:0;">
                    <input type="checkbox" name="applicationIds" value="@c.ApplicationID" class="candidate-cb" style="width:20px; height:20px; accent-color:#006B4D; flex-shrink:0; cursor:pointer;"/>
                    
                    <div style="width:50px; height:50px; border-radius:2px; background:linear-gradient(135deg, #006B4D, #10B981); color:#fff; font-size:1.2rem; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:none;">
                        @(c.FullName?.Length > 0 ? c.FullName.Substring(0,1).ToUpper() : "C")
                    </div>

                    <div style="min-width:0;">
                        <div style="font-weight:800; color:#1A202C; font-size:1rem; display:flex; align-items:center; gap:0.5rem; margin-bottom:0.15rem;">
                            @c.FullName
                            @if (c.SearchStatus == "active")
                            {
                                <span style="background:#dcfce7; color:#166534; padding:0.1rem 0.4rem; border-radius:2px; font-size:0.6rem; text-transform:uppercase; font-weight:700;">Actively Looking</span>
                            }
                            else if (c.SearchStatus == "open")
                            {
                                <span style="background:#fef9c3; color:#854d0e; padding:0.1rem 0.4rem; border-radius:2px; font-size:0.6rem; text-transform:uppercase; font-weight:700;">Open to Offers</span>
                            }
                        </div>
                        <div style="font-size:0.825rem; color:#64748B; margin-bottom:0.65rem; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                             <span style="opacity:0.6;">@c.Email</span>
                             <span style="opacity:0.3;">•</span>
                             <span>@c.YearsOfExperience Years Exp</span>
                             @if (!string.IsNullOrEmpty(c.MatchVerdict) && c.MatchVerdict != "Qualified")
                             {
                                 <span style="opacity:0.3;">•</span>
                                 <span style="color:#e11d48; font-weight:700; font-size:0.75rem;">@c.MatchVerdict</span>
                             }
                        </div>
                        <div style="display:flex; gap:0.4rem; flex-wrap:wrap;">
                            @if (!string.IsNullOrEmpty(c.Skills))
                            {
                                @foreach (var s in c.Skills.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Take(4))
                                {
                                    <span style="background:#F1F5F9; color:#475569; padding:0.2rem 0.6rem; border-radius:2px; font-size:0.7rem; font-weight:700; border:1px solid #E2E8F0;">@s.Trim()</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div style="display:flex; align-items:center; gap:1.75rem; flex-shrink:0;">
                    <!-- Match Score with Heat Indicator -->
                    <div style="text-align:center; cursor:pointer;" onclick="openMatchModal(@c.ApplicationID, '@c.FullName')">
                        <div style="width:56px; height:56px; border-radius:2px; background:@scoreBg; border:3px solid @scoreColor; display:flex; align-items:center; justify-content:center; flex-direction:column; transition: all 0.2s;">
                            <span style="font-size:0.95rem; font-weight:900; color:@scoreColor;">@c.MatchScore%</span>
                        </div>
                        <div style="font-size:0.65rem; color:#94A3B8; margin-top:0.35rem; font-weight:700; text-transform:none;">Match</div>
                    </div>

                    <!-- Status Quick-Switch -->
                    <select class="r-form-control" style="width:145px; font-size:0.875rem; height:40px; font-weight:600; cursor:pointer;" onchange="updateStatusAjax(@c.ApplicationID, this.value)">
                        <option value="Applied" selected="@(c.ApplicationStatus == "Applied")">Applied</option>
                        <option value="UnderReview" selected="@(c.ApplicationStatus == "UnderReview")">Screening</option>
                        <option value="Shortlisted" selected="@(c.ApplicationStatus == "Shortlisted")">Shortlisted</option>
                        <option value="InterviewScheduled" selected="@(c.ApplicationStatus == "InterviewScheduled" || c.ApplicationStatus == "InterviewCompleted")">Interview</option>
                        <option value="Hired" selected="@(c.ApplicationStatus == "Hired" || c.ApplicationStatus == "OfferSent" || c.ApplicationStatus == "Accepted")">Hired</option>
                        <option value="Rejected" selected="@(c.ApplicationStatus == "Rejected")">Rejected</option>
                    </select>

                    <!-- Quick Actions -->
                    <div style="display:flex; gap:0.5rem;">
                        <button type="button" class="r-btn r-btn-secondary" style="padding:0.6rem; border-radius:2px;" title="Preview Resume" onclick="openResume('@c.ResumeFilePath', '@c.FullName')">📄</button>
                        <a href="/Recruiter/CandidateAnalysis?applicationId=@c.ApplicationID" class="r-btn r-btn-secondary" style="padding:0.6rem; border-radius:2px;" title="Deep Analysis">🧠</a>
                    </div>
                </div>
            </div>
        }
    </div>
</form>

<!-- Match Score Detail Modal -->
<div id="matchModal" style="display:none; position:fixed; inset:0; background:rgba(15, 23, 42, 0.75); z-index:3000; align-items:center; justify-content:center; overflow-y:auto;">
    <div style="width:90%; max-width:680px; margin: 2rem auto; background:#ffffff; border-radius:12px; overflow:hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
        <!-- Modal Header -->
        <div style="padding:1.25rem 1.5rem; background:#f8fafc; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div style="background:#eff6ff; padding:8px; border-radius:8px;">
                    <svg width="18" height="18" fill="none" stroke="#3b82f6" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <h3 id="matchModalTitle" style="margin:0; font-weight:700; color:#0f172a; font-size:1rem;">Candidate Match Report</h3>
            </div>
            <button onclick="closeModal('matchModal')" style="border:none; background:none; font-size:1.5rem; cursor:pointer; color:#94a3b8; line-height:1;">✕</button>
        </div>

        <div style="padding:1.5rem;">
            <!-- Loading -->
            <div id="modalLoading" style="text-align:center; padding:3rem 1rem;">
                <div style="width:40px; height:40px; border:3px solid #f1f5f9; border-top:3px solid #3b82f6; border-radius:50%; animation:spin2 1s linear infinite; margin:0 auto 1rem;"></div>
                <p style="color:#64748b; font-size:0.9rem;">Analyzing candidate profile...</p>
            </div>

            <!-- Content -->
            <div id="modalContent" style="display:none;">
                <!-- Score Circle + Label -->
                <div style="text-align:center; margin-bottom:1.5rem;">
                    <div style="font-size:0.65rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">Career Compatibility Score</div>
                    <div id="scoreRing" style="width:90px; height:90px; border-radius:50%; border:6px solid #10b981; background:#f0fdf4; color:#10b981; display:flex; align-items:center; justify-content:center; font-size:1.75rem; font-weight:800; margin:0 auto 0.75rem;">
                        <span id="scoreVal">0</span><span style="font-size:1rem;">%</span>
                    </div>
                    <span id="scoreLabel" style="padding:0.25rem 0.75rem; border-radius:4px; font-size:0.7rem; font-weight:700; letter-spacing:0.05em; background:#dcfce7; color:#166534;">EXCELLENT MATCH</span>
                </div>

                <hr style="border:none; border-top:1px solid #e2e8f0; margin:1.25rem 0;"/>

                <!-- Compatibility Breakdown -->
                <div style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.4rem;">
                    <svg width="14" height="14" fill="none" stroke="#6366f1" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    Compatibility Breakdown
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; margin-bottom:1.25rem;">
                    <div class="rbd-item" id="bd-skill">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                            <span style="font-size:0.72rem; font-weight:600; color:#0f172a;">⚡ Technical Skills</span>
                            <span id="skillVal" style="font-size:0.75rem; font-weight:800; color:#6366f1;">0%</span>
                        </div>
                        <div style="height:4px; background:#f1f5f9; border-radius:2px;"><div id="skillBar" class="rbd-bar" style="background:#6366f1;"></div></div>
                    </div>
                    <div class="rbd-item" id="bd-exp">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                            <span style="font-size:0.72rem; font-weight:600; color:#0f172a;">📊 Experience</span>
                            <span id="expVal" style="font-size:0.75rem; font-weight:800; color:#0ea5e9;">0%</span>
                        </div>
                        <div style="height:4px; background:#f1f5f9; border-radius:2px;"><div id="expBar" class="rbd-bar" style="background:#0ea5e9;"></div></div>
                    </div>
                    <div class="rbd-item" id="bd-kw">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                            <span style="font-size:0.72rem; font-weight:600; color:#0f172a;">🔑 Keyword Match</span>
                            <span id="kwVal" style="font-size:0.75rem; font-weight:800; color:#f59e0b;">0%</span>
                        </div>
                        <div style="height:4px; background:#f1f5f9; border-radius:2px;"><div id="kwBar" class="rbd-bar" style="background:#f59e0b;"></div></div>
                    </div>
                    <div class="rbd-item" id="bd-edu">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.3rem;">
                            <span style="font-size:0.72rem; font-weight:600; color:#0f172a;">🎓 Education</span>
                            <span id="eduVal" style="font-size:0.75rem; font-weight:800; color:#10b981;">0%</span>
                        </div>
                        <div style="height:4px; background:#f1f5f9; border-radius:2px;"><div id="eduBar" class="rbd-bar" style="background:#10b981;"></div></div>
                    </div>
                </div>

                <!-- Verdict -->
                <div style="margin-bottom:1rem;">
                    <div style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.4rem;">
                        <svg width="14" height="14" fill="none" stroke="#0f172a" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        Career Match Verdict
                    </div>
                    <div id="verdictBox" style="background:#f8fafc; border:1px solid #e2e8f0; border-left:4px solid #10b981; border-radius:8px; padding:1rem; font-size:0.85rem; line-height:1.7; color:#0f172a; font-weight:500; text-align:justify; letter-spacing:0.01em;"></div>
                </div>

                <!-- Missing Requirements -->
                <div id="missingSection" style="display:none; margin-bottom:0;">
                    <div style="font-size:0.7rem; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.4rem;">
                        <svg width="14" height="14" fill="none" stroke="#ef4444" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        Missing Requirements
                    </div>
                    <div style="background:#fef2f2; border:1px solid #fecaca; border-left:4px solid #ef4444; border-radius:8px; padding:1rem;">
                        <ul id="missingList" style="margin:0; padding-left:1.25rem; font-size:0.83rem; line-height:1.7; color:#991b1b;"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@@keyframes spin2 { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
.rbd-item { background:#ffffff; border:1px solid #f1f5f9; border-radius:8px; padding:0.65rem 0.75rem; }
.rbd-bar { height:100%; border-radius:2px; width:0%; transition:width 0.8s cubic-bezier(0.4,0,0.2,1); }
.candidate-item:hover { transform:none; box-shadow:none; }
.active-stage { box-shadow:none; transform:none; }
</style>

<!-- Resume Modal -->
<div id="resumeModal" style="display:none; position:fixed; inset:0; background:rgba(15, 23, 42, 0.7);  z-index:4000; align-items:center; justify-content:center;">
    <div class="r-card" style="width:95%; max-width:1100px; height:92vh; padding:0; display:flex; flex-direction:column; border:none; box-shadow:none;">
        <div style="padding:1.25rem 1.75rem; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #EFEFEF;">
            <h5 id="resumeModalTitle" style="margin:0; font-weight:800; color:#1A202C; display:flex; align-items:center; gap:0.5rem;"><span>📄</span> Resume Preview</h5>
            <button onclick="closeModal('resumeModal')" style="border:none; background:none; font-size:1.75rem; cursor:pointer; color:#94A3B8;">&times;</button>
        </div>
        <iframe id="resumeFrame" style="flex:1; border:none; background:#fff;"></iframe>
    </div>
</div>

@section Scripts {
<script>
function openResume(url, name) {
    if (!url) { alert('No resume available for this candidate.'); return; }
    document.getElementById('resumeModalTitle').innerHTML = `<span>📄</span> ${name} — Resume`;
    document.getElementById('resumeFrame').src = url;
    document.getElementById('resumeModal').style.display = 'flex';
}

function openMatchModal(appId, name) {
    document.getElementById('matchModalTitle').innerText = `${name} — Match Report`;
    document.getElementById('modalLoading').style.display = 'block';
    document.getElementById('modalContent').style.display = 'none';
    document.getElementById('matchModal').style.display = 'flex';
    
    fetch(`/Recruiter/GetMatchDetails?applicationId=${appId}`)
        .then(r => r.json())
        .then(response => {
            const data = response.data;
            document.getElementById('modalLoading').style.display = 'none';
            document.getElementById('modalContent').style.display = 'block';

            const score = data.matchScore;
            const scoreColor  = score >= 80 ? '#10b981' : (score >= 50 ? '#f59e0b' : '#ef4444');
            const scoreBg     = score >= 80 ? '#f0fdf4' : (score >= 50 ? '#fffbeb' : '#fef2f2');
            const scoreText   = score >= 80 ? 'EXCELLENT MATCH' : (score >= 50 ? 'GOOD POTENTIAL' : 'LOW ALIGNMENT');
            const labelBg     = score >= 80 ? '#dcfce7' : (score >= 50 ? '#fef3c7' : '#fee2e2');
            const labelColor  = score >= 80 ? '#166534' : (score >= 50 ? '#92400e' : '#991b1b');

            document.getElementById('scoreVal').innerText = score;
            const ring = document.getElementById('scoreRing');
            ring.style.borderColor = scoreColor;
            ring.style.background  = scoreBg;
            ring.style.color       = scoreColor;
            const lbl = document.getElementById('scoreLabel');
            lbl.innerText = scoreText;
            lbl.style.background = labelBg;
            lbl.style.color = labelColor;

            setBar2('skill', data.skillScore,      '#6366f1');
            setBar2('exp',   data.experienceScore, '#0ea5e9');
            setBar2('kw',    data.keywordScore,    '#f59e0b');
            setBar2('edu',   data.educationScore,  '#10b981');

            const verdictBorderColor = data.verdict && data.verdict.toLowerCase().includes('reject') ? '#ef4444' : (score >= 80 ? '#10b981' : '#f59e0b');
            const verdictBox = document.getElementById('verdictBox');
            verdictBox.innerText = data.verdict || 'No verdict available.';
            verdictBox.style.borderLeftColor = verdictBorderColor;

            const missingSection = document.getElementById('missingSection');
            const missingList    = document.getElementById('missingList');
            if (data.missingRequirements && data.missingRequirements.length > 0) {
                missingList.innerHTML = data.missingRequirements.map(r => `<li>${r}</li>`).join('');
                missingSection.style.display = 'block';
            } else {
                missingSection.style.display = 'none';
            }
        });
}

function setBar2(id, val, color) {
    document.getElementById(id + 'Val').innerText = val + '%';
    const bar = document.getElementById(id + 'Bar');
    bar.style.width = val + '%';
    bar.style.background = val >= 75 ? color : (val >= 50 ? '#f59e0b' : '#ef4444');
}

function setBar(id, val) {
    setBar2(id, val, '#3b82f6');
}

function closeModal(id) {
    document.getElementById(id).style.display = 'none';
    if (id === 'resumeModal') document.getElementById('resumeFrame').src = '';
}

// Stage filter
document.querySelectorAll('.filter-stage-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-stage-btn').forEach(b => {
             b.classList.remove('active-stage');
             b.style.background = b.dataset.bg || '#F1F5F9';
             b.style.color = b.dataset.color || '#475569';
        });
        
        const status = this.dataset.status;
        document.querySelectorAll('.candidate-item').forEach(item => {
            if (item.classList.contains('status-group-' + status)) {
                item.style.setProperty('display', 'flex', 'important');
            } else {
                item.style.setProperty('display', 'none', 'important');
            }
        });
        
        this.classList.add('active-stage');
        this.style.background = this.dataset.color || '#3B82F6';
        this.style.color = '#fff';
    });
});

document.getElementById('selectAll')?.addEventListener('change', function() {
    document.querySelectorAll('.candidate-cb').forEach(cb => cb.checked = this.checked);
});

async function updateStatusAjax(appId, status) {
    try {
        const response = await fetch('/Recruiter/UpdateStatusAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ applicationId: appId, status })
        });
        if (response.ok) { window.location.reload(); }
    } catch(e) { console.error(e); }
}
</script>
}
