@model AIResumeScreeningSystem.DTOs.DashboardStatsViewModel
@{ 
    ViewData["Title"] = "Recruiter Dashboard";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
    var userName = ViewBag.UserName as string ?? "Recruiter";
    var currentHour = DateTime.Now.Hour;
    var greeting = currentHour < 12 ? "Good morning" : currentHour < 17 ? "Good afternoon" : "Good evening";
}
@{
    var myJobs = ViewBag.Jobs as List<AIResumeScreeningSystem.Models.Job> ?? new();
    var activeJobs = myJobs.Count(j => j.JobStatus == "Open");
}

<style>
    /* ── Recruiter Dashboard: Professional Blue Design System ── */
    :root {
        --rc-primary: #2563eb;
        --rc-primary-hover: #1d4ed8;
        --rc-dark: #1e40af;
        --rc-light: #eff6ff;
        --rc-accent: #3b82f6;
        --rc-accent-light: #dbeafe;
        --rc-secondary: #1e3a8a;
    }

    .rc-dashboard { 
        display: flex; 
        flex-direction: column; 
        gap: 1.75rem; 
        animation: rcFadeIn 0.4s ease-out; 
        padding-bottom: 2rem; 
    }

    /* Welcome Section */
    .rc-welcome {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.03) 0%, rgba(59, 130, 246, 0.02) 100%);
        padding: 2rem;
        display: flex; 
        justify-content: space-between; 
        align-items: center;
        margin-bottom: 0.5rem;
        border-radius: 8px;
        border: 1px solid rgba(37, 99, 235, 0.1);
    }
    .rc-welcome h1 { 
        font-size: 2rem; 
        font-weight: 800; 
        color: #0f172a; 
        margin-bottom: 0.5rem; 
        letter-spacing: -0.025em; 
    }
    .rc-welcome p { 
        color: #64748b; 
        font-size: 0.95rem; 
        margin: 0; 
        font-weight: 500; 
    }
    .rc-btn-post {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: white; 
        border: none; 
        padding: 0.85rem 1.75rem;
        border-radius: 6px; 
        font-weight: 700; 
        font-size: 0.875rem; 
        text-decoration: none; 
        transition: opacity 0.2s ease;
        white-space: nowrap;
    }
    .rc-btn-post:hover { 
        color: white; 
        opacity: 0.88;
    }

    /* KPI Cards */
    .rc-kpi-row { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 1.5rem; 
    }
    @@media (max-width: 1400px) {
        .rc-kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .rc-kpi {
        background: white; 
        border-radius: 8px; 
        padding: 1.75rem;
        border: 1px solid #e0e7ff; 
        position: relative; 
        overflow: hidden;
    }
    .rc-kpi:hover { 
        border-color: #e0e7ff;
    }
    .rc-kpi-icon { 
        width: 48px; 
        height: 48px; 
        border-radius: 12px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        margin-bottom: 1.25rem; 
        font-size: 1.5rem;
    }
    .rc-kpi h3 { 
        font-size: 2.25rem; 
        font-weight: 800; 
        color: #0f172a; 
        line-height: 1; 
        margin-bottom: 0.5rem; 
        letter-spacing: -0.04em; 
    }
    .rc-kpi p { 
        font-size: 0.75rem; 
        font-weight: 700; 
        color: #64748b; 
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        margin: 0; 
    }
    .rc-kpi-trend { 
        font-size: 0.8rem; 
        font-weight: 600; 
        margin-top: 0.8rem; 
        display: flex; 
        align-items: center; 
        gap: 0.25rem; 
    }
    .rc-trend-up { color: #10b981; }
    .rc-trend-neutral { color: #94a3b8; }
    .rc-sparkline { 
        position: absolute; 
        bottom: 0; 
        left: 0; 
        width: 100%; 
        height: 40px; 
        display: flex; 
        align-items: flex-end; 
        gap: 3px; 
        opacity: 0.06; 
    }
    .rc-sparkline-bar { flex: 1; border-radius: 2px 2px 0 0; }

    .rc-icon-indigo { 
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(59, 130, 246, 0.06)); 
        color: #2563eb; 
    }
    .rc-icon-violet { 
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(124, 58, 237, 0.06)); 
        color: #4f46e5; 
    }
    .rc-icon-blue { 
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(37, 99, 235, 0.06)); 
        color: #3b82f6; 
    }
    .rc-icon-emerald { 
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(5, 150, 105, 0.06)); 
        color: #10b981; 
    }


    /* Recent Table */
    .rc-table-wrap { 
        background: white; 
        border: 1px solid #e0e7ff; 
        border-radius: 8px; 
        padding: 2rem; 
        margin-top: 1.75rem; 
    }
    .rc-table { 
        width: 100%; 
        border-collapse: collapse; 
        text-align: left; 
    }
    .rc-table thead tr { 
        border-bottom: 2px solid #e0e7ff; 
        color: #64748b; 
        font-size: 0.7rem; 
        text-transform: uppercase; 
        letter-spacing: 0.1em; 
    }
    .rc-table th { 
        padding: 1.25rem 0; 
        font-weight: 800; 
        color: var(--rc-primary);
    }
    .rc-table td { 
        padding: 1.5rem 0; 
        font-size: 0.9rem; 
        border-bottom: 1px solid #f1f5f9; 
    }
    .rc-table tr:last-child td { 
        border-bottom: none; 
    }
    .rc-table tbody tr {
        transition: background-color 0.2s ease;
    }
    .rc-table tbody tr:hover {
        background-color: rgba(37, 99, 235, 0.02);
    }
    .rc-name { 
        font-weight: 700; 
        color: #0f172a; 
        font-size: 0.95rem; 
    }
    .rc-email { 
        font-size: 0.8rem; 
        color: #64748b; 
        font-weight: 500; 
        margin-top: 0.25rem; 
    }
    .rc-role-badge { 
        background: #eff6ff; 
        color: #1e40af; 
        padding: 6px 12px; 
        border-radius: 6px; 
        font-size: 0.75rem; 
        font-weight: 700; 
        border: 1px solid #dbeafe; 
        display: inline-block;
    }
    .rc-score { 
        font-weight: 800; 
        padding: 6px 12px; 
        border-radius: 6px; 
        font-size: 0.85rem; 
        display: inline-block;
    }
    .rc-score-hi { 
        background: #ecfdf5; 
        color: #059669; 
        border: 1px solid #d1fae5; 
    }
    .rc-score-mid { 
        background: #fef3c7; 
        color: #b45309; 
        border: 1px solid #fde68a; 
    }
    .rc-score-lo { 
        background: #fee2e2; 
        color: #dc2626; 
        border: 1px solid #fecaca; 
    }
    .rc-status-dot { 
        width: 10px; 
        height: 10px; 
        border-radius: 50%; 
        background: var(--rc-primary); 
        display: inline-block; 
        margin-right: 0.8rem; 
        box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.15); 
    }

    @@keyframes rcFadeIn { 
        from { opacity: 0; } 
        to { opacity: 1; } 
    }
</style>

<div class="rc-dashboard">

    <!-- 1. Welcome -->
    <div class="rc-welcome">
        <div>
            <h1>@greeting, @userName!</h1>
            <p>Your hiring pipeline overview — stay on top of your recruitment workflow.</p>
        </div>
        <a href="/Recruiter/PostJob" class="rc-btn-post">+ Post a Job</a>
    </div>

    <!-- 2. KPI Cards -->
    <div class="rc-kpi-row">
        <div class="rc-kpi">
            <div class="rc-kpi-icon rc-icon-indigo">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <h3>@(Model?.TotalApplicants ?? 0)</h3>
            <p>Total Applicants</p>
            <div class="rc-kpi-trend @(Model?.ApplicantTrendDirection == "up" ? "rc-trend-up" : "rc-trend-neutral")">
                <span>@(Model?.ApplicantTrendPercent > 0 ? $"{Model.ApplicantTrendPercent}% growth" : Model?.ApplicantTrendPercent < 0 ? $"{Math.Abs(Model.ApplicantTrendPercent)}% decline" : "No change")</span>
            </div>
            <div class="rc-sparkline rc-icon-indigo"><div class="rc-sparkline-bar" style="height:30%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:50%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:40%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:70%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:60%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:80%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:55%;background:currentColor"></div></div>
        </div>

        <div class="rc-kpi">
            <div class="rc-kpi-icon rc-icon-violet">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3>@activeJobs</h3>
            <p>Active Jobs</p>
            <div class="rc-kpi-trend rc-trend-neutral"><span>@(Model?.ActiveJobsTrend ?? "Stable")</span></div>
            <div class="rc-sparkline rc-icon-violet"><div class="rc-sparkline-bar" style="height:20%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:60%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:40%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:80%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:50%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:30%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:70%;background:currentColor"></div></div>
        </div>

        <div class="rc-kpi">
            <div class="rc-kpi-icon rc-icon-blue">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <h3>@(Model?.AverageMatchScore.ToString("0.0"))%</h3>
            <p>Avg. Match Score</p>
            <div class="rc-kpi-trend @(Model?.AverageMatchScore >= 70 ? "rc-trend-up" : "rc-trend-neutral")"><span>@(Model?.MatchScoreTrend ?? "Stable")</span></div>
            <div class="rc-sparkline rc-icon-blue"><div class="rc-sparkline-bar" style="height:45%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:65%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:35%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:55%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:75%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:50%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:85%;background:currentColor"></div></div>
        </div>

        <div class="rc-kpi">
            <div class="rc-kpi-icon rc-icon-emerald">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h3>@(Model?.ScheduledInterviews ?? 0)</h3>
            <p>Interviews</p>
            <div class="rc-kpi-trend rc-trend-neutral"><span>@(Model?.InterviewsTrend ?? "None scheduled")</span></div>
            <div class="rc-sparkline rc-icon-emerald"><div class="rc-sparkline-bar" style="height:10%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:25%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:15%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:40%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:20%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:60%;background:currentColor"></div><div class="rc-sparkline-bar" style="height:35%;background:currentColor"></div></div>
        </div>
    </div>


    <!-- 4. Recent Applicants Table (full width) -->
    <div class="rc-table-wrap">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <h2 class="rc-panel-title" style="margin: 0;">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Recent Applicants
            </h2>
            <a href="/Recruiter/Candidates" style="font-size: 0.78rem; font-weight: 700; color: var(--rc-primary); text-decoration: none;">View Full Bank &rarr;</a>
        </div>
        <table class="rc-table">
            <thead>
                <tr>
                    <th>Candidate</th>
                    <th>Target Role</th>
                    <th>AI Match</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.RecentCandidates != null && Model.RecentCandidates.Any())
                {
                    @foreach (var candidate in Model.RecentCandidates.Take(5))
                    {
                        <tr>
                            <td>
                                <div class="rc-name">@candidate.FullName</div>
                                <div class="rc-email">@candidate.Email</div>
                            </td>
                            <td><span class="rc-role-badge">@candidate.JobTitle</span></td>
                            <td>
                                @{
                                    var scoreClass = candidate.MatchScore >= 75 ? "rc-score-hi" : candidate.MatchScore >= 50 ? "rc-score-mid" : "rc-score-lo";
                                }
                                <span class="rc-score @scoreClass">@(candidate.MatchScore.ToString("0"))%</span>
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; font-size: 0.82rem; font-weight: 600;">
                                    <span class="rc-status-dot"></span>
                                    @candidate.ApplicationStatus
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-light); padding: 2rem; font-size: 0.85rem;">
                            No recent application activity found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
