@model List<AIResumeScreeningSystem.Models.Job>
@{
    ViewData["Title"] = "Manage Jobs";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
    var totalJobs  = Model.Count;
    var openJobs   = Model.Count(j => j.JobStatus == "Open");
    var closedJobs = Model.Count(j => j.JobStatus == "Closed");
    var totalApps  = Model.Sum(j => j.Applications?.Count ?? 0);
}

<style>
    /* ── Page Layout ── */
    .jl-page { display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 2rem; font-family: 'Inter', sans-serif; }

    /* ── Header ── */
    .jl-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid #e2e8f0;
    }
    .jl-header h1 { font-size: 1.6rem; font-weight: 800; color: #0f172a; margin: 0 0 0.2rem; }
    .jl-header p  { color: #64748b; margin: 0; font-size: 0.9rem; }
    .jl-post-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #2563eb;
        color: #fff;
        padding: 0.7rem 1.4rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.875rem;
        text-decoration: none;
        transition: background 0.15s ease;
        white-space: nowrap;
    }
    .jl-post-btn:hover { background: #1d4ed8; color: #fff; }

    /* ── KPI Strip ── */
    .jl-kpi-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }
    .jl-kpi {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .jl-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .jl-kpi-val  { font-size: 1.75rem; font-weight: 800; line-height: 1; }
    .jl-kpi-lbl  { font-size: 0.75rem; font-weight: 600; color: #64748b; margin-top: 0.2rem; text-transform: uppercase; letter-spacing: 0.04em; }

    /* ── Toolbar ── */
    .jl-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.85rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }
    .jl-tabs { display: flex; gap: 0.4rem; }
    .jl-tab {
        padding: 0.45rem 1.1rem;
        border-radius: 6px;
        border: none;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        background: #f1f5f9;
        color: #475569;
        transition: all 0.15s ease;
    }
    .jl-tab:hover  { background: #e2e8f0; }
    .jl-tab.active { background: #2563eb; color: #fff; }

    .jl-search {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 6px;
        padding: 0.45rem 0.9rem;
        min-width: 240px;
        transition: border-color 0.15s;
    }
    .jl-search:focus-within { border-color: #2563eb; }
    .jl-search input { border: none; background: transparent; outline: none; font-size: 0.875rem; flex: 1; color: #1e293b; }
    .jl-search svg { color: #94a3b8; flex-shrink: 0; }

    /* ── Job Card ── */
    .jl-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        transition: border-color 0.15s ease;
    }
    .jl-card:hover { border-color: #2563eb; }
    .jl-card.closed { opacity: 0.65; }

    /* Avatar */
    .jl-avatar {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        letter-spacing: 0.05em;
    }

    /* Info */
    .jl-info { flex: 1; min-width: 0; }
    .jl-title-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
    .jl-title { font-size: 1rem; font-weight: 800; color: #0f172a; margin: 0; }

    /* Badges */
    .jl-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.18rem 0.65rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .jl-badge-open   { background: #dcfce7; color: #15803d; }
    .jl-badge-closed { background: #fee2e2; color: #b91c1c; }
    .jl-badge-gray   { background: #f1f5f9; color: #475569; }
    .jl-badge-blue   { background: #dbeafe; color: #1d4ed8; }
    .jl-badge-teal   { background: #ccfbf1; color: #0f766e; }

    .jl-meta {
        display: flex;
        gap: 1.1rem;
        font-size: 0.8rem;
        color: #64748b;
        margin-bottom: 0.6rem;
        flex-wrap: wrap;
        align-items: center;
    }
    .jl-meta span { display: flex; align-items: center; gap: 0.3rem; }
    .jl-meta-dot { color: #cbd5e1; }

    .jl-skills { display: flex; gap: 0.35rem; flex-wrap: wrap; }
    .jl-skill {
        background: #f1f5f9;
        color: #475569;
        padding: 0.15rem 0.55rem;
        border-radius: 4px;
        font-size: 0.72rem;
        font-weight: 600;
    }

    /* Right side */
    .jl-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.75rem; flex-shrink: 0; }
    .jl-apps-count { text-align: center; }
    .jl-apps-num { font-size: 1.6rem; font-weight: 800; line-height: 1; }
    .jl-apps-lbl { font-size: 0.68rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }

    .jl-actions { display: flex; gap: 0.4rem; align-items: center; }
    .jl-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        background: none;
    }
    .jl-btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }
    .jl-btn-primary:hover { background: #1d4ed8; color: #fff; }
    .jl-btn-primary.disabled { opacity: 0.45; pointer-events: none; }
    .jl-btn-info    { background: #f0f9ff; color: #0369a1; border-color: #bae6fd; }
    .jl-btn-info:hover { background: #e0f2fe; }
    .jl-btn-edit    { background: #f8fafc; color: #475569; border-color: #e2e8f0; }
    .jl-btn-edit:hover { background: #f1f5f9; color: #1e293b; }
    .jl-btn-danger  { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
    .jl-btn-danger:hover { background: #fee2e2; }

    /* Deadline badge */
    .jl-deadline-urgent { color: #ef4444 !important; font-weight: 700; }
    .jl-deadline-new    { color: #3b82f6 !important; font-weight: 700; }

    /* Empty state */
    .jl-empty {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 5rem 2rem;
        text-align: center;
    }

    @@media (max-width: 1100px) { .jl-kpi-row { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 768px)  { .jl-header, .jl-toolbar { flex-direction: column; align-items: flex-start; } .jl-card { flex-direction: column; align-items: flex-start; } }
</style>

<div class="jl-page">

    <!-- Header -->
    <div class="jl-header">
        <div>
            <h1>Job Listings</h1>
            <p>Manage your posted vacancies and track applicant activity</p>
        </div>
        <a href="/Recruiter/PostJob" class="jl-post-btn">
            <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Post New Job
        </a>
    </div>

    <!-- KPI Strip -->
    <div class="jl-kpi-row">
        <div class="jl-kpi">
            <div class="jl-kpi-icon" style="background:#dbeafe; color:#2563eb;">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            </div>
            <div>
                <div class="jl-kpi-val" style="color:#2563eb;">@totalJobs</div>
                <div class="jl-kpi-lbl">Total Jobs</div>
            </div>
        </div>
        <div class="jl-kpi">
            <div class="jl-kpi-icon" style="background:#dcfce7; color:#16a34a;">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
                <div class="jl-kpi-val" style="color:#16a34a;">@openJobs</div>
                <div class="jl-kpi-lbl">Active</div>
            </div>
        </div>
        <div class="jl-kpi">
            <div class="jl-kpi-icon" style="background:#fee2e2; color:#ef4444;">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            </div>
            <div>
                <div class="jl-kpi-val" style="color:#ef4444;">@closedJobs</div>
                <div class="jl-kpi-lbl">Closed</div>
            </div>
        </div>
        <div class="jl-kpi">
            <div class="jl-kpi-icon" style="background:#f3e8ff; color:#7c3aed;">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <div>
                <div class="jl-kpi-val" style="color:#7c3aed;">@totalApps</div>
                <div class="jl-kpi-lbl">Total Applications</div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="jl-toolbar">
        <div class="jl-tabs">
            <button class="jl-tab active" data-filter="all">All <span style="opacity:0.75;">(@totalJobs)</span></button>
            <button class="jl-tab" data-filter="Open">Active <span style="opacity:0.75;">(@openJobs)</span></button>
            <button class="jl-tab" data-filter="Closed">Closed <span style="opacity:0.75;">(@closedJobs)</span></button>
        </div>
        <div class="jl-search">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="text" id="jobSearch" placeholder="Search by title, location..." />
        </div>
    </div>

    <!-- Jobs List -->
    @if (!Model.Any())
    {
        <div class="jl-empty">
            <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#cbd5e1" stroke-width="1.5" style="margin-bottom:1rem;"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            <h3 style="font-size:1.15rem; font-weight:700; color:#1e293b; margin:0 0 0.5rem;">No Jobs Posted Yet</h3>
            <p style="color:#64748b; margin:0 0 2rem; font-size:0.9rem;">Post your first vacancy to start attracting great candidates.</p>
            <a href="/Recruiter/PostJob" class="jl-action-btn jl-btn-primary" style="padding:0.75rem 2rem; font-size:0.9rem;">+ Post Your First Job</a>
        </div>
    }
    else
    {
        <div style="display:grid; gap:0.75rem;" id="jobsList">
            @foreach (var job in Model)
            {
                var appCount    = job.Applications?.Count ?? 0;
                var deadlineDays = job.ApplicationDeadline != null ? (job.ApplicationDeadline.Value - DateTime.Now).Days : -999;
                var isOpen       = job.JobStatus == "Open";
                var isExpiring   = deadlineDays is >= 0 and <= 3;
                var isNew        = (DateTime.Now - job.CreatedDate).TotalDays <= 2;
                var dStr         = deadlineDays == -999 ? "No deadline" : deadlineDays < 0 ? "Expired" : deadlineDays == 0 ? "Closes today" : $"{deadlineDays}d left";
                var avatarText   = job.JobTitle.Substring(0, Math.Min(2, job.JobTitle.Length)).ToUpper();
                var sectorBadge  = job.JobSector == "Govt" ? "jl-badge-blue" : "jl-badge-teal";

                <div class="jl-card @(!isOpen ? "closed" : "")" data-status="@job.JobStatus" data-title="@job.JobTitle.ToLower()">

                    <!-- Avatar -->
                    <div class="jl-avatar">@avatarText</div>

                    <!-- Info -->
                    <div class="jl-info">
                        <div class="jl-title-row">
                            <h3 class="jl-title">@job.JobTitle</h3>
                            <span class="jl-badge @(isOpen ? "jl-badge-open" : "jl-badge-closed")">
                                <svg width="5" height="5" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4" fill="currentColor"/></svg>
                                @job.JobStatus
                            </span>
                            @if (!string.IsNullOrEmpty(job.JobType))
                            {
                                <span class="jl-badge jl-badge-gray">@job.JobType</span>
                            }
                            @if (!string.IsNullOrEmpty(job.JobSector))
                            {
                                <span class="jl-badge @sectorBadge">@job.JobSector</span>
                            }
                        </div>

                        <div class="jl-meta">
                            @if (!string.IsNullOrEmpty(job.JobLocation))
                            {
                                <span>
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    @job.JobLocation
                                </span>
                                <span class="jl-meta-dot">•</span>
                            }
                            <span>
                                <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Posted @job.CreatedDate.ToString("MMM dd, yyyy")
                            </span>
                            @if (job.SalaryMin > 0)
                            {
                                <span class="jl-meta-dot">•</span>
                                <span>
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                                    ৳@job.SalaryMin.ToString("N0") @(job.SalaryMax > 0 ? $"– {job.SalaryMax:N0}" : "+")
                                </span>
                            }
                            @if (job.ApplicationDeadline != null)
                            {
                                <span class="jl-meta-dot">•</span>
                                <span class="@(isExpiring ? "jl-deadline-urgent" : isNew ? "jl-deadline-new" : "")">
                                    <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    @dStr
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(job.RequiredSkills))
                        {
                            var skills = job.RequiredSkills.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="jl-skills">
                                @foreach (var sk in skills.Take(4))
                                {
                                    <span class="jl-skill">@sk.Trim()</span>
                                }
                                @if (skills.Length > 4)
                                {
                                    <span class="jl-skill" style="background:#e2e8f0; color:#64748b;">+@(skills.Length - 4) more</span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Right -->
                    <div class="jl-right">
                        <div class="jl-apps-count">
                            <div class="jl-apps-num" style="color:@(appCount > 0 ? "#2563eb" : "#cbd5e1");">@appCount</div>
                            <div class="jl-apps-lbl">Applicants</div>
                        </div>
                        <div class="jl-actions">
                            <a href="/Recruiter/Candidates?jobId=@job.JobID"
                               class="jl-action-btn jl-btn-primary @(appCount == 0 ? "disabled" : "")" title="View Applicants">
                                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                @(appCount > 0 ? $"{appCount} Applicants" : "Applicants")
                            </a>
                            @if (!string.IsNullOrEmpty(job.AttachmentPath))
                            {
                                <a href="@job.AttachmentPath" target="_blank" class="jl-action-btn jl-btn-info" title="Download Circular">
                                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    Circular
                                </a>
                            }
                            <a href="/Recruiter/EditJob?jobId=@job.JobID" class="jl-action-btn jl-btn-edit" title="Edit Job">
                                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Edit
                            </a>
                            @if (isOpen)
                            {
                                <form method="post" asp-action="CloseJob" style="margin:0;">
                                    <input type="hidden" name="jobId" value="@job.JobID"/>
                                    <button type="submit" class="jl-action-btn jl-btn-danger" title="Close Job"
                                            onclick="return confirm('Are you sure you want to close this job?')">
                                        <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                        Close
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@section Scripts {
<script>
    // Filter tabs
    document.querySelectorAll('.jl-tab').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.jl-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const filter = btn.dataset.filter;
            document.querySelectorAll('#jobsList [data-status]').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.status === filter) ? '' : 'none';
            });
        });
    });

    // Live search
    document.getElementById('jobSearch')?.addEventListener('input', function () {
        const q = this.value.toLowerCase().trim();
        document.querySelectorAll('#jobsList [data-title]').forEach(card => {
            card.style.display = (!q || card.dataset.title.includes(q)) ? '' : 'none';
        });
    });
</script>
}
