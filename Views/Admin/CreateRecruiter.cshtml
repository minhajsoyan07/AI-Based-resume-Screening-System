@model AIResumeScreeningSystem.DTOs.CreateRecruiterDTO
@{
    ViewData["Title"] = "Add Recruiter";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var companies = ViewBag.Companies as List<AIResumeScreeningSystem.Models.Company> ?? new List<AIResumeScreeningSystem.Models.Company>();
}

<div class="page-header fade-in">
    <div>
        <h1>Add New Recruiter</h1>
        <p>Create a new recruiter account manually for the platform.</p>
    </div>
    <div>
        <a href="/portal/admin/Recruiters" class="btn btn-outline" style="border-color:var(--border-color);color:var(--text-main);font-weight:600;text-decoration:none;">
            ← Back to Recruiters
        </a>
    </div>
</div>

<div class="fade-in" style="max-width:800px;">
    <div class="card">
        <div class="card-header">
            <h3>
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                Recruiter Information
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="CreateRecruiter" asp-controller="Admin" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:1rem;"></div>

                <div class="row" style="display:flex;gap:1.5rem;margin-bottom:1.25rem;flex-wrap:wrap;">
                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="FullName" class="form-label">Full Name <span class="required">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="Email" class="form-label">Email Address <span class="required">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row" style="display:flex;gap:1.5rem;margin-bottom:1.25rem;flex-wrap:wrap;">
                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="Password" class="form-label">Password <span class="required">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.3rem;">Must be at least 6 characters.</div>
                    </div>
                    
                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="Designation" class="form-label">Designation</label>
                        <input asp-for="Designation" class="form-control" placeholder="e.g. Senior HR Manager" />
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>
                </div>

                <hr style="border:none;border-top:1px dashed var(--border-color);margin:1.5rem 0;" />

                <div class="row" style="display:flex;gap:1.5rem;margin-bottom:1.5rem;flex-wrap:wrap;">
                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="CompanyID" class="form-label">Assign to Existing Company</label>
                        <select asp-for="CompanyID" class="form-control">
                            <option value="">-- Select Company (Optional) --</option>
                            @foreach (var c in companies)
                            {
                                <option value="@c.CompanyID">@c.CompanyName</option>
                            }
                        </select>
                        <span asp-validation-for="CompanyID" class="text-danger"></span>
                    </div>

                    <div class="form-group" style="flex:1;min-width:280px;margin-bottom:0;">
                        <label asp-for="CompanyName" class="form-label">Or Create New Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="New Company Ltd." />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                        <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.3rem;">Leave empty if selecting an existing company above.</div>
                    </div>
                </div>

                <div style="display:flex;gap:1rem;margin-top:2rem;">
                    <button type="submit" class="btn btn-primary" style="background:var(--admin-primary);border:none;padding:0.75rem 1.5rem;">
                        Create Recruiter Account
                    </button>
                    <a href="/portal/admin/Recruiters" class="btn btn-outline" style="padding:0.75rem 1.5rem;text-decoration:none;">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
