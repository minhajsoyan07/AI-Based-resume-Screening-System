@model AIResumeScreeningSystem.DTOs.AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Platform Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var statusColors = new Dictionary<string, string>
    {
        ["Applied"]     = "var(--admin-primary)",
        ["Shortlisted"] = "#2563eb",
        ["Rejected"]    = "#dc2626",
        ["Hired"]       = "#059669",
        ["Withdrawn"]   = "#64748b"
    };
    var scoreBarColors = new[] { "#059669", "#2563eb", "#d97706", "#dc2626" };
    int totalApps      = Model.TotalApplications > 0 ? Model.TotalApplications : 1;
    int maxSkillCount  = Model.TopSkills.Any() ? Model.TopSkills.Max(s => s.Count) : 1;
    int scoreTotal     = Model.ScoreDistribution.Sum(s => s.Count);
}

<div class="fade-in" style="padding: 1.75rem 0;">

    <div class="page-header">
        <div>
            <h1>Platform Analytics</h1>
            <p>Insight into application flow, hiring performance and skill trends.</p>
        </div>
        <span style="font-size:0.8rem;color:var(--text-muted);">@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
    </div>

    <!-- KPI Row -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-bottom:1.5rem;">
        <div class="kpi-card">
            <div class="kpi-icon green">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@Model.TotalHired</div>
                <div class="kpi-label">Total Hired</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon purple-bg">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@Model.AvgAIScore<span style="font-size:1rem;">%</span></div>
                <div class="kpi-label">Avg AI Match Score</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon yellow">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@Model.TotalApplications</div>
                <div class="kpi-label">Total Applications</div>
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">

        <!-- Applications by Status -->
        <div class="card">
            <div class="card-header"><h3>Applications by Status</h3></div>
            <div class="card-body">
                @if (!Model.AppsByStatus.Any())
                {
                    <p style="text-align:center;color:var(--text-muted);padding:1.5rem 0;">No application data yet.</p>
                }
                @foreach (var item in Model.AppsByStatus)
                {
                    double pct = Math.Round((double)item.Count / totalApps * 100, 1);
                    string color = statusColors.GetValueOrDefault(item.Status, "#94a3b8");
                    <div style="margin-bottom:0.85rem;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                            <span style="font-size:0.85rem;font-weight:600;color:var(--text-main);">@item.Status</span>
                            <span style="font-size:0.82rem;color:var(--text-muted);">@item.Count <span style="font-size:0.75rem;">(@pct%)</span></span>
                        </div>
                        <div style="background:var(--bg-main);border-radius:2px;height:7px;overflow:hidden;">
                            <div style="width:@(pct)%;height:100%;background:@color;border-radius:2px;transition:width 0.6s ease;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- AI Score Distribution -->
        <div class="card">
            <div class="card-header"><h3>AI Score Distribution</h3></div>
            <div class="card-body">
                @if (scoreTotal == 0)
                {
                    <p style="text-align:center;color:var(--text-muted);padding:1.5rem 0;">No score data yet.</p>
                }
                @for (int i = 0; i < Model.ScoreDistribution.Count; i++)
                {
                    var band = Model.ScoreDistribution[i];
                    double pct2 = scoreTotal > 0 ? Math.Round((double)band.Count / scoreTotal * 100, 1) : 0;
                    <div style="margin-bottom:0.85rem;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:0.25rem;">
                            <span style="font-size:0.85rem;font-weight:600;color:var(--text-main);">@band.Range</span>
                            <span style="font-size:0.82rem;color:var(--text-muted);">@band.Count candidates</span>
                        </div>
                        <div style="background:var(--bg-main);border-radius:2px;height:7px;overflow:hidden;">
                            <div style="width:@(pct2)%;height:100%;background:@scoreBarColors[i % scoreBarColors.Length];border-radius:2px;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">

        <!-- Top Jobs -->
        <div class="card">
            <div class="card-header"><h3>Top Jobs by Applications</h3></div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Title</th>
                            <th style="text-align:right;">Apps</th>
                            <th style="text-align:right;">Avg Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.TopJobs)
                        {
                            string scoreBadge = job.AvgScore >= 75 ? "badge-active" : job.AvgScore >= 50 ? "badge-purple" : "badge-pending";
                            <tr>
                                <td style="font-weight:600;font-size:0.88rem;">@job.JobTitle</td>
                                <td style="text-align:right;color:var(--text-muted);">@job.Count</td>
                                <td style="text-align:right;"><span class="@scoreBadge">@job.AvgScore%</span></td>
                            </tr>
                        }
                        @if (!Model.TopJobs.Any())
                        {
                            <tr><td colspan="3" style="text-align:center;padding:1.5rem;color:var(--text-muted);">No job data yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top Skills in Demand -->
        <div class="card">
            <div class="card-header"><h3>Top Skills in Demand</h3></div>
            <div class="card-body">
                @if (!Model.TopSkills.Any())
                {
                    <p style="text-align:center;color:var(--text-muted);padding:1.5rem 0;">No skill data yet.</p>
                }
                @foreach (var skill in Model.TopSkills)
                {
                    double pct3 = Math.Round((double)skill.Count / maxSkillCount * 100, 0);
                    <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.65rem;">
                        <span style="font-size:0.82rem;font-weight:600;color:var(--text-main);width:120px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@skill.SkillName">@skill.SkillName</span>
                        <div style="flex:1;background:var(--bg-main);border-radius:2px;height:7px;overflow:hidden;">
                            <div style="width:@(pct3)%;height:100%;background:var(--admin-primary);border-radius:2px;transition:width 0.5s ease;"></div>
                        </div>
                        <span style="font-size:0.75rem;color:var(--text-muted);width:28px;text-align:right;">@skill.Count</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
