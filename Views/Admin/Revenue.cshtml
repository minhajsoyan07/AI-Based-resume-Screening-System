@model List<AIResumeScreeningSystem.Models.CreditTransaction>
@{
    ViewData["Title"] = "Revenue Tracking";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    decimal totalRevenue      = ViewBag.TotalRevenue      ?? 0m;
    decimal thisMonthRevenue  = ViewBag.ThisMonthRevenue  ?? 0m;
    int totalTransactions     = ViewBag.TotalTransactions ?? 0;
    decimal avgPerTransaction = totalTransactions > 0 ? totalRevenue / totalTransactions : 0m;
}

@section Styles {
    <style>
        @@media print {
            /* Hide UI elements not meant for printing */
            .app-sidebar, .app-header, .btn-print {
                display: none !important;
            }
            
            /* Reset layout wrappers to flow naturally from top-left */
            .app-wrapper {
                display: block !important;
                margin: 0 !important;
                padding: 0 !important;
                height: auto !important;
                overflow: visible !important;
            }
            
            .app-content {
                position: static !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
            }

            /* Clean up cards for printing */
            .card { border: none !important; box-shadow: none !important; }
            .kpi-card { break-inside: avoid; border: 1px solid #ddd !important; }
            .data-table th, .data-table td { border-bottom: 1px solid #ddd !important; }
            
            /* Ensure document margins */
            @@page { margin: 1cm; }
        }
    </style>
}

<div class="fade-in" style="padding: 1.75rem 0;">

    <div class="page-header" style="align-items: center;">
        <div>
            <h1>Revenue Tracking</h1>
            <p>Earnings from applicant credit package purchases.</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline btn-print" style="border-color:var(--admin-primary);color:var(--admin-primary);display:flex;align-items:center;gap:0.5rem;font-weight:600;">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            Download PDF
        </button>
    </div>

    <!-- KPIs -->
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem;margin-bottom:1.75rem;">
        <div class="kpi-card">
            <div class="kpi-icon green">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">৳@totalRevenue.ToString("N0")</div>
                <div class="kpi-label">Total Revenue</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon purple-bg">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">৳@thisMonthRevenue.ToString("N0")</div>
                <div class="kpi-label">Last 30 Days</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon blue">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">@totalTransactions</div>
                <div class="kpi-label">Total Purchases</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon yellow">
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10"/></svg>
            </div>
            <div class="kpi-content">
                <div class="kpi-value">৳@avgPerTransaction.ToString("N0")</div>
                <div class="kpi-label">Avg per Purchase</div>
            </div>
        </div>
    </div>

    <!-- Transaction Table -->
    <div class="card">
        <div class="card-header">
            <h3>
                <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                All Transactions
                <span class="badge-neutral" style="margin-left:0.5rem;font-weight:600;">@totalTransactions total</span>
            </h3>
        </div>
        <div class="card-body" style="padding:0;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Applicant</th>
                        <th>Package</th>
                        <th>Payment Method</th>
                        <th style="text-align:right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trx in Model)
                    {
                        <tr>
                            <td style="font-size:0.82rem;color:var(--text-muted);white-space:nowrap;">
                                @trx.CreatedAt.ToString("dd MMM yyyy")<br/>
                                <span style="font-size:0.75rem;">@trx.CreatedAt.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <div style="font-weight:700;color:var(--text-main);font-size:0.88rem;">@(trx.User?.FullName ?? "—")</div>
                                <div style="font-size:0.75rem;color:var(--text-muted);">@trx.User?.Email</div>
                            </td>
                            <td>
                                <span style="font-weight:600;font-size:0.88rem;">@trx.CreditsAmount Credits</span><br/>
                                <span class="badge-active" style="margin-top:0.2rem;display:inline-block;">Paid</span>
                            </td>
                            <td>
                                <span class="badge-neutral">@(trx.PaymentMethod ?? "—")</span>
                            </td>
                            <td style="text-align:right;font-weight:800;color:var(--admin-primary);font-size:1rem;">
                                ৳@trx.AmountBDT.ToString("N2")
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" style="text-align:center;padding:3rem;color:var(--text-muted);">
                                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="display:block;margin:0 auto 0.5rem;opacity:0.4;"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2"/></svg>
                                No transactions yet. Revenue is recorded here when applicants purchase credit packages.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
