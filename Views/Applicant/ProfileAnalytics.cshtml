@using AIResumeScreeningSystem.DTOs
@model ProfileAnalyticsViewModel
@{
    ViewData["Title"] = "Profile Analytics";
    Layout = "~/Views/Shared/_ApplicantLayout.cshtml";
}

<style>
    .analytics-wrapper {
        font-family: 'SolaimanLipi', 'Inter', -apple-system, blinkmacsystemfont, sans-serif !important;
        padding-bottom: 2rem;
    }

    .analytics-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        margin-top: 0.85rem; /* Vertically align with sidebar text */
    }

    .analytics-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }

    .analytics-subtitle {
        color: var(--text-muted);
        font-size: 0.9rem;
    }


    /* Top Grid */
    .four-col-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .metric-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        padding: 1.25rem;
        border-radius: var(--radius-lg);
        box-shadow:none;
    }
    
    .metric-card-primary {
        background: linear-gradient(135deg, var(--brand-primary), var(--brand-dark));
        color: white;
        border: none;
    }

    .metric-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform:none;
        margin-bottom: 0.5rem;
    }

    .metric-card .metric-label { color: var(--text-muted); }
    .metric-card-primary .metric-label { opacity: 0.85; }

    .metric-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
    }
    .metric-card-primary .metric-value { color: white; }

    .metric-sub {
        font-size: 0.75rem;
        margin-top: 0.25rem;
        font-weight: 500;
    }
    .metric-card .metric-sub { color: var(--text-muted); }
    .metric-card-primary .metric-sub { opacity: 0.8; }

    /* Single Chart Card */
    .chart-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .section-head {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .trend-chart-area {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        height: 140px;
        padding-top: 1rem;
        margin-top: 0.5rem;
        border-top: 1px dashed var(--border-light);
    }

    .trend-bar-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        height: 100%;
        justify-content: flex-end;
    }

    .trend-bar-value {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--brand-primary);
    }

    .trend-bar {
        width: 100%;
        background: linear-gradient(180deg, var(--brand-primary), var(--brand-dark));
        border-radius:2px 6px 0 0;
        min-height: 4px;
        transition: height 0.3s ease-out;
    }

    .trend-bar-label {
        font-size: 0.65rem;
        color: var(--text-muted);
        font-weight: 700;
        text-transform:none;
    }

    /* Two Col Grid */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .funnel-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .funnel-item {
        text-align: center;
        padding: 1rem 0.5rem;
        border-radius: var(--radius-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }
    
    .funnel-val { font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .funnel-lbl { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform:none; letter-spacing: 0.05em; }

    .funnel-1 { background: #eff6ff; } .funnel-1 .funnel-val { color: #2563eb; }
    .funnel-2 { background: #ecfdf5; } .funnel-2 .funnel-val { color: #059669; }
    .funnel-3 { background: #f5f3ff; } .funnel-3 .funnel-val { color: #7c3aed; }
    .funnel-4 { background: #fef3c7; } .funnel-4 .funnel-val { color: #d97706; }

    .rate-box {
        background: var(--bg-gray);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        text-align: center;
    }
    .rate-box-lbl { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600; text-transform:none; }
    .rate-box-val { font-size: 2rem; font-weight: 800; }

    /* Skills Progress */
    .skill-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .skill-info {
        flex: 1;
    }

    .skill-head {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.35rem;
    }
    .skill-name { font-size: 0.85rem; font-weight: 700; color: var(--text-main); }
    .skill-pct { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }

    .skill-track {
        background: var(--border-light);
        border-radius: var(--radius-full);
        height: 6px;
        overflow: hidden;
    }
    .skill-fill {
        background: linear-gradient(90deg, var(--brand-primary), var(--accent-blue));
        height: 100%;
        border-radius: var(--radius-full);
    }

    .empty-skills {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-muted);
    }
    .empty-skills p { font-size: 0.85rem; margin-top: 0.5rem; font-weight: 500; }
    
    /* Suggestions Area */
    .sugg-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }
    
    .sugg-count {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform:none;
    }

    .sugg-item {
        display: flex;
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
    }
    
    .sugg-item.pri-high { border-left: 4px solid var(--accent-red); background: #fef2f2; }
    .sugg-item.pri-med { border-left: 4px solid var(--accent-yellow); background: #fffbeb; }
    .sugg-item.pri-low { border-left: 4px solid var(--border-light); background: var(--bg-white); }

    .sugg-icon { font-size: 1.5rem; flex-shrink: 0; }
    .sugg-content { flex: 1; min-width: 0; }
    
    .sugg-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.35rem;
    }
    
    .sugg-section { font-weight: 800; font-size: 0.95rem; color: var(--text-main); }
    .sugg-badge { font-size: 0.65rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: var(--radius-full); text-transform:none; }
    
    .badge-high { background: var(--accent-red); color: white; }
    .badge-med { background: var(--accent-yellow); color: white; }
    .badge-low { background: var(--border-color); color: var(--text-muted); }

    .sugg-current { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 500; }
    .sugg-text { font-size: 0.85rem; color: var(--text-main); line-height: 1.5; margin: 0; }

    .sugg-perfect {
        text-align: center;
        padding: 3rem 1rem;
    }
    .sugg-perfect h4 { color: var(--accent-green); font-weight: 800; margin: 0.5rem 0; }
    .sugg-perfect p { color: var(--text-muted); font-size: 0.85rem; margin: 0; }


    @@media (max-width: 992px) {
        .four-col-grid { grid-template-columns: repeat(2, 1fr); }
        .two-col-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="analytics-wrapper">

    <div class="analytics-header">
        <div>
            <h1 class="analytics-title">📊 Profile Analytics</h1>
            <p class="analytics-subtitle">Track your profile performance and optimize your visibility</p>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="four-col-grid">
        <div class="metric-card metric-card-primary">
            <div class="metric-label">Profile Views</div>
            <div class="metric-value">@Model.TotalProfileViews</div>
            <div class="metric-sub">+@Model.ProfileViewsThisWeek this week</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Search Appearances</div>
            <div class="metric-value" style="color:#2563eb;">@Model.SearchAppearances</div>
            <div class="metric-sub">+@Model.SearchAppearancesThisWeek this week</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Unique Recruiters</div>
            <div class="metric-value" style="color:#059669;">@Model.UniqueRecruiterViews</div>
            <div class="metric-sub">different recruiters viewed you</div>
        </div>
        <div class="metric-card">
            <div class="metric-label">Click-Through Rate</div>
            <div class="metric-value" style="color:#d97706;">@Model.ClickThroughRate%</div>
            <div class="metric-sub">from search to profile</div>
        </div>
    </div>

    <!-- View Trend Chart -->
    <div class="chart-card">
        <h2 class="section-head">📈 Profile Views — Last 7 Days</h2>
        <div class="trend-chart-area">
            @foreach (var day in Model.ViewTrend)
            {
                var maxViews = Math.Max(Model.ViewTrend.Max(d => d.Views), 1);
                var heightPercent = Math.Max(5, (double)day.Views / maxViews * 100);
                <div class="trend-bar-wrap">
                    <span class="trend-bar-value">@day.Views</span>
                    <div class="trend-bar" style="height:@(heightPercent)%;"></div>
                    <span class="trend-bar-label">@day.Date.ToString("ddd")</span>
                </div>
            }
        </div>
    </div>

    <!-- Application Success & Skills -->
    <div class="two-col-grid">
        <!-- Application Success -->
        <div class="chart-card" style="margin-bottom:0;">
            <h2 class="section-head">🎯 Application Success Rate</h2>
            <div class="funnel-grid">
                <div class="funnel-item funnel-1">
                    <div class="funnel-val">@Model.TotalApplications</div>
                    <div class="funnel-lbl">Total Applied</div>
                </div>
                <div class="funnel-item funnel-2">
                    <div class="funnel-val">@Model.ShortlistedCount</div>
                    <div class="funnel-lbl">Shortlisted</div>
                </div>
                <div class="funnel-item funnel-3">
                    <div class="funnel-val">@Model.InterviewedCount</div>
                    <div class="funnel-lbl">Interviewed</div>
                </div>
                <div class="funnel-item funnel-4">
                    <div class="funnel-val">@Model.HiredCount</div>
                    <div class="funnel-lbl">Hired</div>
                </div>
            </div>
            <div class="rate-box">
                <div class="rate-box-lbl">Success Rate (Shortlisted / Applied)</div>
                <div class="rate-box-val" style="color: @(@Model.ApplicationSuccessRate >= 30 ? "var(--accent-green)" : @Model.ApplicationSuccessRate >= 15 ? "var(--accent-yellow)" : "var(--accent-red)");">@Model.ApplicationSuccessRate%</div>
            </div>
        </div>

        <!-- Top Attracting Skills -->
        <div class="chart-card" style="margin-bottom:0;">
            <h2 class="section-head">🔥 Skills Attracting Recruiters</h2>
            @if (Model.TopAttractingSkills.Any())
            {
                foreach (var skill in Model.TopAttractingSkills)
                {
                    <div class="skill-row">
                        <div class="skill-info">
                            <div class="skill-head">
                                <span class="skill-name">@skill.SkillName</span>
                                <span class="skill-pct">@skill.Percentage% match</span>
                            </div>
                            <div class="skill-track">
                                <div class="skill-fill" style="width:@(Math.Max(5, skill.Percentage))%;"></div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-skills">
                    <div style="font-size:2rem; margin-bottom:0.5rem;">⚙️</div>
                    <p>Apply to more jobs to see which skills attract recruiters.</p>
                </div>
            }
        </div>
    </div>

    <!-- Profile Optimization Suggestions -->
    <div class="chart-card">
        <div class="sugg-head">
            <h2 class="section-head" style="margin:0;">💡 Profile Optimization Suggestions</h2>
            <span class="sugg-count">@Model.Suggestions.Count suggestion@(Model.Suggestions.Count != 1 ? "s" : "")</span>
        </div>
        
        @if (Model.Suggestions.Any())
        {
            foreach (var suggestion in Model.Suggestions)
            {
                var rowClass = suggestion.Priority == "High" ? "pri-high" : suggestion.Priority == "Medium" ? "pri-med" : "pri-low";
                var badgeClass = suggestion.Priority == "High" ? "badge-high" : suggestion.Priority == "Medium" ? "badge-med" : "badge-low";
                
                <div class="sugg-item @rowClass">
                    <div class="sugg-icon">@suggestion.Icon</div>
                    <div class="sugg-content">
                        <div class="sugg-top">
                            <span class="sugg-section">@suggestion.Section</span>
                            <span class="sugg-badge @badgeClass">@suggestion.Priority</span>
                        </div>
                        <div class="sugg-current">Current: @suggestion.CurrentState</div>
                        <p class="sugg-text">@suggestion.Suggestion</p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="sugg-perfect">
                <div style="font-size:2.5rem; margin-bottom:0.5rem;">🎉</div>
                <h4>Your profile is well optimized!</h4>
                <p>No major improvements needed. Keep your profile updated for best results.</p>
            </div>
        }
    </div>



</div>
