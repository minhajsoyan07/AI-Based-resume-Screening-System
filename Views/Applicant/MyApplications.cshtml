@model List<AIResumeScreeningSystem.Models.Application>
@{ 
    ViewData["Title"] = "My Applications"; 
    Layout = "~/Views/Shared/_ApplicantLayout.cshtml";
}

<style>
    .my-apps-wrapper {
        font-family: 'SolaimanLipi', 'Inter', -apple-system, blinkmacsystemfont, sans-serif !important;
        padding-bottom: 2rem;
    }

    .apps-header-section {
        margin-bottom: 2rem;
        margin-top: 0.85rem; /* Vertically align with sidebar text */
    }

    .apps-header-top {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .apps-badge {
        display: inline-flex;
        align-items: center;
        background: #ecfdf5;
        color: #059669;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-md);
        font-weight: 800;
        font-size: 0.65rem;
        border: 1px solid #a7f3d0;
        text-transform:none;
        letter-spacing: 0.05em;
    }

    .apps-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0;
        line-height: 1.1;
    }

    .apps-subtitle {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.9rem;
    }

    /* KPI Grid - Flattened */
    .apps-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 2.5rem;
    }
    
    .app-kpi-card {
        background: var(--bg-white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 1.25rem;
        display: flex;
        gap: 1rem;
        align-items: center;
    }
    
    .app-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    
    .app-kpi-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text-main);
        line-height: 1;
        margin-bottom: 0.25rem;
        letter-spacing: -0.02em;
    }
    
    .app-kpi-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform:none;
        letter-spacing: 0.04em;
    }

    .icon-blue { background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; }
    .icon-orange { background: #fffbeb; color: #b45309; border: 1px solid #fef3c7; }
    .icon-green { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .icon-purple { background: #faf5ff; color: #7e22ce; border: 1px solid #e9d5ff; }

    /* Table Card - High Density */
    .table-card {
        background: var(--bg-white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .table-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .table-title {
        font-weight: 800;
        color: var(--text-main);
        font-size: 1rem;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        background: #f8fafc;
        padding: 0.85rem 1.25rem;
        font-size: 0.65rem;
        font-weight: 800;
        color: #64748b;
        border-bottom: 1px solid var(--border-color);
        text-transform:none;
        letter-spacing: 0.05em;
        text-align: left;
    }

    .data-table td {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-light);
        font-size: 0.9rem;
    }

    .data-row:hover { background: #fcfdfe; }

    .company-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .company-initial {
        width: 32px;
        height: 32px;
        border-radius: var(--radius-sm);
        background: #f1f5f9;
        color: #475569;
        border: 1px solid var(--border-color);
        font-weight: 800;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .job-title-link {
        font-weight: 800;
        color: var(--text-main);
        text-decoration: none;
        display: block;
        margin-bottom: 0.1rem;
    }
    .job-title-link:hover { color: var(--brand-primary); }

    .job-meta-small {
        font-size: 0.75rem;
        color: var(--text-muted);
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .status-badge {
        display: inline-flex;
        padding: 0.25rem 0.75rem;
        border-radius: var(--radius-sm);
        font-size: 0.7rem;
        font-weight: 800;
        text-transform:none;
        letter-spacing: 0.03em;
    }
    .status-applied { background: #f1f5f9; color: #475569; }
    .status-review { background: #fffbeb; color: #b45309; }
    .status-shortlist { background: #eff6ff; color: #1d4ed8; }
    .status-offer { background: #f0fdf4; color: #15803d; }
    .status-rejected { background: #fef2f2; color: #b91c1c; }

    /* Legend */
    .matching-legend {
        margin-top: 2rem;
        padding: 1.5rem;
        background: #f8fafc;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
    }
    
    .legend-title {
        font-weight: 800;
        font-size: 0.85rem;
        color: var(--text-main);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .legend-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .legend-item b { display: block; font-size: 0.9rem; margin-bottom: 0.2rem; }
    .legend-item p { font-size: 0.75rem; color: var(--text-muted); margin: 0; line-height: 1.4; }

    @@media (max-width: 992px) {
        .apps-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .legend-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="my-apps-wrapper">
    <div class="apps-header-section">
        <div class="apps-header-top">
            <h1 class="apps-title">My Applications</h1>
            <div class="apps-badge">Application Center</div>
        </div>
        <p class="apps-subtitle">Track the status of your active job applications and recruitment process.</p>
    </div>

    @{
        var total = Model.Count;
        var pending = Model.Count(a => a.ApplicationStatus == "Applied" || a.ApplicationStatus == "UnderReview");
        var shortlisted = Model.Count(a => a.ApplicationStatus == "Shortlisted" || a.ApplicationStatus == "InterviewScheduled");
        var hired = Model.Count(a => a.ApplicationStatus == "Hired" || a.ApplicationStatus == "OfferSent");
    }

    <div class="apps-kpi-grid">
        <div class="app-kpi-card">
            <div class="app-kpi-icon icon-blue">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div>
                <div class="app-kpi-value">@total</div>
                <div class="app-kpi-label">Applied</div>
            </div>
        </div>
        <div class="app-kpi-card">
            <div class="app-kpi-icon icon-orange">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
                <div class="app-kpi-value">@pending</div>
                <div class="app-kpi-label">In Review</div>
            </div>
        </div>
        <div class="app-kpi-card">
            <div class="app-kpi-icon icon-green">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
            </div>
            <div>
                <div class="app-kpi-value">@shortlisted</div>
                <div class="app-kpi-label">Shortlisted</div>
            </div>
        </div>
        <div class="app-kpi-card">
            <div class="app-kpi-icon icon-purple">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
                <div class="app-kpi-value">@hired</div>
                <div class="app-kpi-label">Offers</div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="table-card" style="padding: 5rem 2rem; text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1.5rem;">📋</div>
            <h3 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.75rem;">No Applications Yet</h3>
            <p style="color: var(--text-muted); margin-bottom: 2.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">You haven't applied to any roles. Browse current openings to find your next opportunity.</p>
            <a href="/Applicant/BrowseJobs" class="a-btn a-btn-primary" style="padding: 0.875rem 2.5rem;">Discover Jobs</a>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-header">
                <div class="table-title">Recent Submissions (@total)</div>
                <a href="/Applicant/BrowseJobs" style="font-size: 0.8rem; font-weight: 700; color: var(--brand-primary); text-decoration: none;">View More Opportunities →</a>
            </div>
            <div style="overflow-x: auto;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Job Information</th>
                            <th>Employer</th>
                            <th>AI Match</th>
                            <th>Status</th>
                            <th>Applied On</th>
                            <th style="text-align: right;">Options</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr class="data-row">
                                <td>
                                    <a href="/Applicant/JobDetails?jobId=@app.JobID" class="job-title-link">@app.Job.JobTitle</a>
                                    <div class="job-meta-small">ID: @app.ApplicationTrackingID • 📍 @(app.Job.JobLocation ?? "Remote")</div>
                                </td>
                                <td>
                                    <div class="company-cell">
                                        @{
                                            var empName = app.Job.Company?.CompanyName ?? app.Job.Recruiter?.CompanyName ?? "—";
                                            var initial = string.IsNullOrEmpty(empName) || empName == "—" ? "C" : empName.Substring(0, 1).ToUpper();
                                        }
                                        <div class="company-initial">@initial</div>
                                        <div class="company-name" style="font-weight: 600; font-size: 0.85rem;">@empName</div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var scoreColor = app.MatchScore >= 75 ? "#10b981" : app.MatchScore >= 50 ? "#3b82f6" : "#f59e0b";
                                    }
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <span style="font-weight: 900; color: @scoreColor; font-size: 1rem;">@app.MatchScore%</span>
                                        <div style="width: 40px; height: 4px; background: #f1f5f9; border-radius: 2px; overflow: hidden;">
                                            <div style="width: @app.MatchScore%; height: 100%; background: @scoreColor;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var statusClass = app.ApplicationStatus switch {
                                            "Applied" => "status-applied",
                                            "UnderReview" => "status-review",
                                            "Shortlisted" or "InterviewScheduled" => "status-shortlist",
                                            "Hired" or "OfferSent" => "status-offer",
                                            "Rejected" => "status-rejected",
                                            _ => "status-applied"
                                        };
                                        var displayStatus = app.ApplicationStatus == "UnderReview" ? "In Review" : 
                                                            app.ApplicationStatus == "InterviewScheduled" ? "Interview" : 
                                                            app.ApplicationStatus == "OfferSent" ? "Offer" : app.ApplicationStatus;
                                    }
                                    <div class="status-badge @statusClass">@displayStatus</div>
                                </td>
                                <td style="font-weight: 500; color: var(--text-muted); font-size: 0.8rem;">@app.AppliedDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align: right;">
                                    <div style="display: flex; justify-content: flex-end; gap: 0.4rem;">
                                        <a href="/Applicant/JobDetails?jobId=@app.JobID" class="a-btn a-btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.75rem;">Details</a>
                                        @if (app.ApplicationStatus == "Applied")
                                        {
                                            <form method="post" asp-action="WithdrawApplication" onsubmit="return confirm('Withdraw application?');">
                                                <input type="hidden" name="applicationId" value="@app.ApplicationID"/>
                                                <button type="submit" class="a-btn" style="padding: 0.4rem 0.75rem; font-size: 0.75rem; background: #fef2f2; color: #b91c1c; border-color: #fecaca;">Withdraw</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="matching-legend">
        <div class="legend-title">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>
            Understanding Your AI Match Score
        </div>
        <div class="legend-grid">
            <div class="legend-item">
                <b style="color: #10b981;">75-100%</b>
                <p>Excellent fit. Your profile closely matches all core requirements.</p>
            </div>
            <div class="legend-item">
                <b style="color: #3b82f6;">50-74%</b>
                <p>Strong candidate. Meets primary technical needs with some minor gaps.</p>
            </div>
            <div class="legend-item">
                <b style="color: #f59e0b;">25-49%</b>
                <p>Potential match. Consider highlighting specific transferable skills.</p>
            </div>
            <div class="legend-item">
                <b style="color: #ef4444;">0-24%</b>
                <p>Low alignment. We recommend refining your resume for this role.</p>
            </div>
        </div>
    </div>
</div>

