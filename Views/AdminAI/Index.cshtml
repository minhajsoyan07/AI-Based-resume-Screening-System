@using AIResumeScreeningSystem.Services
@{
    ViewData["Title"] = "AI Engine Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ai-dash { display: flex; flex-direction: column; gap: 1.25rem; animation: aiFadeIn 0.4s ease-out; }

    /* KPI Row */
    .ai-kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .ai-kpi {
        background: white; border: 1px solid var(--border-color); border-radius: 2px;
        padding: 1.25rem 1.5rem; position: relative; overflow: hidden;
    }
    .ai-kpi-icon { width: 38px; height: 38px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem; }
    .ai-kpi h3 { font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.15rem; line-height: 1; }
    .ai-kpi p { font-size: 0.72rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin: 0; }

    /* Panels */
    .ai-panel { background: white; border: 1px solid var(--border-color); border-radius: 2px; padding: 1.5rem; }
    .ai-panel-title {
        font-size: 0.85rem; font-weight: 700; color: var(--text-muted); display: flex; align-items: center;
        gap: 0.4rem; margin: 0 0 1.25rem 0; text-transform: uppercase; letter-spacing: 0.06em;
    }

    /* Grid */
    .ai-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }

    /* Button Styles */
    .ai-btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.25rem;
        border-radius: 2px; font-weight: 700; font-size: 0.85rem; border: none; cursor: pointer; transition: all 0.15s;
    }
    .ai-btn-primary { background: var(--brand-primary); color: white; }
    .ai-btn-primary:hover { background: var(--brand-dark); }
    .ai-btn-secondary { background: #f1f5f9; color: var(--text-main); border: 1px solid var(--border-color); }
    .ai-btn-secondary:hover { background: #e2e8f0; }

    /* Result Box */
    .ai-result {
        display: none; margin-top: 1rem; padding: 1rem 1.25rem; background: #f0fdf4; border: 1px solid #bbf7d0;
        border-radius: 2px; font-weight: 700; font-size: 0.9rem; color: #065f46;
    }

    /* Alert */
    .ai-alert-ok { background: #ecfdf5; color: #065f46; padding: 0.85rem 1.25rem; border-radius: 2px; margin-bottom: 1rem; font-weight: 600; font-size: 0.88rem; border: 1px solid #a7f3d0; }
    .ai-alert-err { background: #fef2f2; color: #991b1b; padding: 0.85rem 1.25rem; border-radius: 2px; margin-bottom: 1rem; font-weight: 600; font-size: 0.88rem; border: 1px solid #fecaca; }

    /* Textarea */
    .ai-textarea {
        width: 100%; border: 1px solid var(--border-color); border-radius: 2px; padding: 0.85rem 1rem;
        font-size: 0.88rem; font-family: inherit; resize: vertical; min-height: 100px; transition: border-color 0.15s;
    }
    .ai-textarea:focus { outline: none; border-color: var(--brand-primary); box-shadow: 0 0 0 3px rgba(0,122,90,0.08); }
    .ai-textarea::placeholder { color: var(--text-light); }

    /* Status Indicator */
    .ai-status { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; font-weight: 700; }
    .ai-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .ai-dot-green { background: #10b981; }
    .ai-dot-amber { background: #f59e0b; }

    @@keyframes aiFadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

<div class="ai-dash">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ai-alert-ok">✓ @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ai-alert-err">✕ @TempData["ErrorMessage"]</div>
    }

    <!-- KPI Cards -->
    <div class="ai-kpi-row">
        <div class="ai-kpi">
            <div class="ai-kpi-icon" style="background:#ecfdf5; color:#10b981;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="ai-status"><span class="ai-dot ai-dot-green"></span> Online</h3>
            <p>Engine Status</p>
        </div>
        <div class="ai-kpi">
            <div class="ai-kpi-icon" style="background:#eef2ff; color:#4f46e5;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </div>
            <h3>Training</h3>
            <p>Model Retraining</p>
        </div>
        <div class="ai-kpi">
            <div class="ai-kpi-icon" style="background:#f5f3ff; color:#7c3aed;">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            </div>
            <h3>Predictor</h3>
            <p>Text Classification</p>
        </div>
    </div>

    <!-- Main Grid: Training + Predictor -->
    <div class="ai-grid">
        <!-- Model Training -->
        <div class="ai-panel">
            <h2 class="ai-panel-title">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Model Training
            </h2>
            <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.6; margin-bottom: 1.25rem;">
                Initiate a manual retraining of the core ML models using the latest application data and feedback loops. This process may take a few moments depending on dataset size.
            </p>
            <form asp-controller="AdminAI" asp-action="TrainModel" method="post">
                <button type="submit" class="ai-btn ai-btn-primary">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Start Training Cycle
                </button>
            </form>
        </div>

        <!-- Test Predictor -->
        <div class="ai-panel">
            <h2 class="ai-panel-title">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                Test Predictor
            </h2>
            <textarea id="testText" class="ai-textarea" placeholder="Enter text to classify (e.g., job description or profile summary)..."></textarea>
            <div style="margin-top: 0.75rem;">
                <button type="button" id="btnPredict" class="ai-btn ai-btn-secondary">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    Analyze Text
                </button>
            </div>
            <div id="predictionResult" class="ai-result">
                Predicted Category: <span id="predValue" style="color: var(--brand-primary);"></span>
            </div>
        </div>
    </div>

</div>

<script>
    document.getElementById('btnPredict').addEventListener('click', async () => {
        const text = document.getElementById('testText').value;
        if (!text.trim()) return alert("Please enter text.");
        
        try {
            const res = await fetch('/AdminAI/TestPrediction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Text: text })
            });
            if (res.ok) {
                const data = await res.json();
                document.getElementById('predValue').innerText = data.category;
                document.getElementById('predictionResult').style.display = 'block';
            } else {
                alert("Prediction failed.");
            }
        } catch (e) {
            console.error(e);
            alert("Error occurred.");
        }
    });
</script>
