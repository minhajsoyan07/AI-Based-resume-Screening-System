@model List<AIResumeScreeningSystem.Models.Job>
@{ 
    ViewData["Title"] = "ResuMatch AI | Precision Screening"; 
    var totalJobs = Model?.Count ?? 0;
    var liveJobs = Model?.Count(j => j.JobStatus == "Open") ?? 0;
}

<style>
    /* Hero Section - Compact & Clean */
    .lp-hero-section {
        padding: 0;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 3rem;
        align-items: center;
        min-height: calc(100vh - 120px);
    }

    /* Full screen width override */
    .container {
        max-width: 100% !important;
        padding: 0 6rem !important;
    }

    /* Remove layout margin for this page */
    main {
        margin-top: 0 !important;
        background: white; /* Ensure consistent background */
    }

    .lp-hero-content {
        display: flex;
        flex-direction: column;
    }

    /* 2 Credit Badge */
    .lp-offer-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: rgba(0, 122, 90, 0.08);
        color: var(--brand-primary);
        padding: 0.4rem 1rem;
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 800;
        border: 1px solid rgba(0, 122, 90, 0.15);
        width: fit-content;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .lp-title {
        font-size: 3.25rem;
        font-weight: 800;
        color: var(--brand-dark);
        margin-bottom: 0.75rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .lp-subtitle {
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: 1.75rem;
        max-width: 600px;
        line-height: 1.4;
    }

    /* Core Stats Cards */
    .lp-card-row {
        display: flex; 
        gap: 1rem; 
        margin-bottom: 1.5rem;
    }

    .lp-dashed-card {
        flex: 1;
        border: 1.5px dashed var(--brand-primary);
        border-radius: 16px;
        padding: 1.25rem 1.75rem;
        background: white;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        box-shadow: var(--shadow-sm);
    }

    .lp-card-icon {
        width: 48px; 
        height: 48px; 
        background: var(--brand-light); 
        border-radius: 12px; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        font-size: 1.4rem;
    }

    .lp-dashed-card .num {
        font-size: 2rem;
        font-weight: 800;
        color: var(--brand-dark);
        line-height: 1;
    }

    .lp-dashed-card .label {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin-top: 0.2rem;
    }

    /* Search Interface */
    .lp-search-wrap {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        display: flex;
        align-items: center;
        padding: 0.5rem;
        box-shadow: var(--shadow-md);
        margin-bottom: 1.5rem;
        max-width: 700px;
    }

    .lp-search-icon {
        padding-left: 1.25rem;
        color: var(--text-light);
        font-size: 1.2rem;
    }

    .lp-search-wrap input {
        flex: 1;
        border: none;
        outline: none;
        padding: 0.8rem 1rem;
        font-size: 1.05rem;
        color: var(--text-main);
    }

    .lp-search-btn {
        background: var(--brand-primary);
        color: white;
        border: none;
        padding: 0.9rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background var(--transition-fast);
    }

    .lp-search-btn:hover {
        background: var(--brand-dark);
    }

    /* Illustration */
    .lp-illustration {
        display: flex;
        justify-content: flex-end;
        position: relative;
    }

    .lp-illustration img {
        width: 100%;
        max-width: 450px;
        filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.12));
    }

    .circle-glow {
        position: absolute;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(0, 122, 90, 0.05) 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: -1;
    }

    /* Simplified CTA Bar */
    .hero-cta-bar {
        background: var(--brand-dark);
        padding: 1.25rem 3rem;
        border-radius: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: white;
        box-shadow: var(--shadow-lg);
        margin-top: 1rem;
    }

    .hero-cta-text {
        font-size: 1.25rem;
        font-weight: 700;
        max-width: 500px;
    }

    .hero-cta-text span {
        display: block;
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.7);
        margin-top: 0.35rem;
    }

    .btn-cta-main {
        background: var(--brand-primary);
        color: white !important;
        padding: 0.7rem 1.75rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.8rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .btn-cta-main:hover {
        background: #008f69;
        color: white !important;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(0, 122, 90, 0.2);
    }

    /* Fix selection visibility */
    .btn-cta-main::selection {
        background: white;
        color: var(--brand-primary);
    }

    @@media (max-width: 992px) {
        .lp-hero-section { grid-template-columns: 1fr; text-align: center; }
        .lp-offer-badge { margin: 0 auto 1.5rem; }
        .lp-illustration { order: -1; justify-content: center; }
        .hero-cta-bar { flex-direction: column; gap: 2rem; text-align: center; }
    }
</style>

<div class="container">
    <section class="lp-hero-section">
        <div class="lp-hero-content">
            <div class="lp-offer-badge">
                <span>🎁</span> 2 AI Credits Bonus for New Applicants
            </div>
            
            <h1 class="lp-title">Precision AI Screening</h1>
            <p class="lp-subtitle">
                Optimize your recruitment with ResuMatch Intelligence. State-of-the-art semantic matching between talent and opportunity.
            </p>

            <div class="lp-card-row">
                <div class="lp-dashed-card">
                    <div class="lp-card-icon">🏛️</div>
                    <div>
                        <div class="num">@totalJobs</div>
                        <div class="label">Total Jobs</div>
                    </div>
                </div>
                <div class="lp-dashed-card">
                    <div class="lp-card-icon">🎯</div>
                    <div>
                        <div class="num">@liveJobs</div>
                        <div class="label">Live Roles</div>
                    </div>
                </div>
            </div>

            <form method="get" action="/Applicant/BrowseJobs">
                <div class="lp-search-wrap">
                    <span class="lp-search-icon">🔍</span>
                    <input type="text" name="search" placeholder="Search by role, company, or skills..." aria-label="Search">
                    <button type="submit" class="lp-search-btn">START SCANNING</button>
                </div>
            </form>

            <div class="hero-cta-bar">
                <div class="hero-cta-text">
                    Ready to bridge the gap?
                    <span>Create an applicant account today and unlock your 2 free AI credits instantly.</span>
                </div>
                <a href="/Auth/Register" class="btn-cta-main">
                    CREATE ACCOUNT NOW <span>→</span>
                </a>
            </div>
        </div>

        <div class="lp-illustration">
            <div class="circle-glow"></div>
            <img src="/images/hero-illustration.png" alt="ResuMatch">
        </div>
    </section>
</div>
