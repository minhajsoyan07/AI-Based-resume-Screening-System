<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Recruiter Portal | Janala</title>
    <meta name="description" content="Janala — AI Recruitment Platform: Recruiter Portal"/>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css"/>
    
    <style>
        /* ══════════════════════════════════════════════════════════════════════════════════
           RECRUITER LAYOUT: PROFESSIONAL BLUE COLOR SCHEME
           ══════════════════════════════════════════════════════════════════════════════════ */

        :root {
            --recruiter-primary: #2563eb;
            --recruiter-primary-hover: #1d4ed8;
            --recruiter-dark: #1e40af;
            --recruiter-light: #eff6ff;
            --recruiter-accent: #3b82f6;
        }

        /* Sidebar: no extra border or shadow on wrapper */
        .app-sidebar {
            border: none !important;
            box-shadow: none !important;
        }

        .app-sidebar > .sidebar-menu {
            border: 1px solid var(--border-color);
            background: var(--bg-white);
        }

        /* Sidebar Links — Blue Theme */
        .sidebar-link {
            color: #334155;
            font-weight: 500;
        }
        .sidebar-link:hover {
            background-color: rgba(37, 99, 235, 0.08);
            color: var(--recruiter-primary);
        }
        .sidebar-link:hover svg { color: var(--recruiter-primary); }
        .sidebar-link.active {
            background: rgba(37, 99, 235, 0.75);
            color: white;
            font-weight: 600;
        }
        .sidebar-link.active svg { color: white; }

        /* Module Headers — Blue Theme */
        .module-header { color: #334155; }
        .module-header:hover {
            background-color: rgba(37, 99, 235, 0.08);
            color: var(--recruiter-primary);
        }
        .module-header:hover .module-header-content svg { color: var(--recruiter-primary); }
        .module-header.active {
            background-color: rgba(37, 99, 235, 0.08);
            color: var(--recruiter-primary);
        }
        .module-header.active .module-header-content svg { color: var(--recruiter-primary); }
        .module-arrow { color: var(--recruiter-accent); }

        /* Submenu Links — Blue Theme */
        .submenu-link { color: #475569; font-weight: 500; font-size: 0.9rem; }
        .submenu-link:hover {
            color: var(--recruiter-primary);
            background-color: rgba(37, 99, 235, 0.06);
        }
        .submenu-link.active {
            color: var(--recruiter-primary);
            font-weight: 600;
            background-color: rgba(37, 99, 235, 0.1);
            border-left: 2px solid var(--recruiter-primary);
        }

        /* Sign Out Button */
        .app-sidebar .btn[style*="background:#ef4444"] {
            background: #ef4444 !important;
            border-color: #ef4444 !important;
        }
        .app-sidebar .btn[style*="background:#ef4444"]:hover {
            background: #dc2626 !important;
        }

        /* Form Focus — Blue Theme */
        .form-control:focus {
            border-color: var(--recruiter-primary) !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1) !important;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
@{
    var activePage = ViewContext.RouteData.Values["Action"]?.ToString();
    var userName = ViewBag.UserName as string ?? "Recruiter";
    var userHome = ViewBag.UserHome as string ?? "/Recruiter";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "R";
}
<body>
    <partial name="_Notifications" />

    <header class="app-header">
        <div class="container nav-container">
            <a href="@userHome" class="brand-logo" style="text-decoration: none; display: flex; align-items: center; position: relative; padding-right: 48px;">
                <img src="/images/logo.png" alt="Janala Logo" style="height: 58px; width: auto; display: block; transform:none; transform-origin: left;" />
                <span style="position: absolute; top: -2px; right: -10px; background: #7c3aed; color: white; font-size: 0.6rem; font-weight: 900; padding: 2px 6px; border-radius: 2px; text-transform:none; border: 2px solid white; box-shadow:none; line-height: 1;">Recruiter</span>
            </a>

            <nav class="desktop-nav">
                <a href="/Recruiter/Candidates" class="nav-link">Find Talent</a>
                <a href="/Recruiter/PostJob" class="nav-link">Post a Job</a>
                <a href="#" class="nav-link">Support</a>
                
                <div class="nav-dropdown" style="margin-left: 0.5rem;">
                    <button class="nav-link" style="background:none; border:none; display:flex; align-items:center; gap:0.5rem; cursor:pointer; padding:0.25rem;">
                        <div style="width:36px; height:36px; border-radius:50%; background:var(--brand-primary); color:white; display:flex; align-items:center; justify-content:center; font-weight:700;">
                            @userInitial
                        </div>
                        <span style="font-weight:600; color:var(--text-main); margin-left:0.5rem;">@userName</span>
                    </button>
                    <div class="nav-dropdown-menu" style="right: 0; left: auto; min-width: 200px;">
                        <div class="nav-dropdown-item" style="border-bottom: 1px solid var(--border-light); pointer-events: none;">
                            <span style="font-weight: 700;">@userName</span>
                        </div>
                        <a href="/Recruiter/Profile" class="nav-dropdown-item">
                            <span>My Profile</span>
                        </a>
                        <a href="/Auth/Logout" class="nav-dropdown-item" style="color: var(--accent-red); font-weight: 700;">
                            <span>Sign Out</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <div class="app-wrapper">
        <aside class="app-sidebar">

            <ul class="sidebar-menu">
                <!-- Dashboard -->
                <li class="sidebar-item">
                    <a href="/Recruiter" class="sidebar-link @(activePage == "Index" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        Dashboard
                    </a>
                </li>

                <!-- Post a Job -->
                <li class="sidebar-item">
                    <a href="/Recruiter/PostJob" class="sidebar-link @(activePage == "PostJob" || activePage == "GenerateJobDescription" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        Post a Job
                    </a>
                </li>

                <!-- Manage Jobs -->
                <li class="sidebar-item">
                    <a href="/Recruiter/Jobs" class="sidebar-link @(activePage == "Jobs" || activePage == "EditJob" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
                        Manage Jobs
                    </a>
                </li>

                <!-- CV Bank -->
                <li class="sidebar-item">
                    <a href="/Recruiter/Candidates" class="sidebar-link @(activePage == "Candidates" || activePage == "CandidateAnalysis" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        CV Bank
                    </a>
                </li>

                <!-- Interviews -->
                <li class="sidebar-item">
                    <a href="/Recruiter/Interviews" class="sidebar-link @(activePage == "Interviews" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Interviews
                    </a>
                </li>

                <!-- Company Profile -->
                <li class="sidebar-item">
                    <a href="/Recruiter/Profile" class="sidebar-link @(activePage == "Profile" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        Company Profile
                    </a>
                </li>
            </ul>
            
            <div style="margin-top: auto;">
                <a href="/Auth/Logout" class="btn w-100" style="background:#ef4444; border-color:#ef4444; color:white; display:flex; align-items:center; justify-content:flex-start; gap:0.85rem; font-weight:600; padding:0.6rem 0.5rem; border-radius:0;">
                    <svg style="width:20px;height:20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Sign Out
                </a>
            </div>
        </aside>

        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="/js/site.js"></script>
    @RenderSection("Scripts", required: false)
    
    <script>
        // Sidebar Module Toggle
        function toggleSidebarModule(header) {
            const module = header.parentElement;
            const isOpen = module.classList.contains('open');
            document.querySelectorAll('.sidebar-module').forEach(m => m.classList.remove('open'));
            if (!isOpen) module.classList.add('open');
        }
    </script>
</body>
</html>
