<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Admin Portal | Janala</title>
    <meta name="description" content="Janala — AI Recruitment Platform: Admin Portal"/>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    <style>
        /* ═══════════════════════════════════════════════════════════════
           ADMIN PORTAL — PURPLE THEME (mirrors Recruiter blue pattern)
           ═══════════════════════════════════════════════════════════════ */
        :root {
            --admin-primary:       #7c3aed;
            --admin-primary-hover: #6d28d9;
            --admin-dark:          #4c1d95;
            --admin-light:         #f5f3ff;
            --admin-accent:        #8b5cf6;
        }

        /* Sidebar wrapper — no extra border/shadow */
        .app-sidebar { border: none !important; box-shadow: none !important; }
        .app-sidebar > .sidebar-menu { border: 1px solid var(--border-color); background: var(--bg-white); }

        /* Sidebar links — purple */
        .sidebar-link { color: #334155; font-weight: 500; }
        .sidebar-link:hover { background-color: rgba(124,58,237,0.08); color: var(--admin-primary); }
        .sidebar-link:hover svg { color: var(--admin-primary); }
        .sidebar-link.active { background: rgba(124,58,237,0.75); color: white; font-weight: 600; }
        .sidebar-link.active svg { color: white; }

        /* Module headers — purple */
        .module-header { color: #334155; }
        .module-header:hover { background-color: rgba(124,58,237,0.08); color: var(--admin-primary); }
        .module-header:hover .module-header-content svg { color: var(--admin-primary); }
        .module-header.active { background-color: rgba(124,58,237,0.08); color: var(--admin-primary); }
        .module-header.active .module-header-content svg { color: var(--admin-primary); }
        .module-arrow { color: var(--admin-accent); }

        /* Submenu links — purple */
        .submenu-link { color: #475569; font-weight: 500; font-size: 0.9rem; }
        .submenu-link:hover { color: var(--admin-primary); background-color: rgba(124,58,237,0.06); }
        .submenu-link.active {
            color: var(--admin-primary); font-weight: 600;
            background-color: rgba(124,58,237,0.1);
            border-left: 2px solid var(--admin-primary);
        }

        /* Form focus — purple */
        .form-control:focus {
            border-color: var(--admin-primary) !important;
            box-shadow: 0 0 0 3px rgba(124,58,237,0.1) !important;
        }

        /* Simple data table (used by all admin list views) */
        .data-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        .data-table th {
            text-align: left; padding: 0.75rem 1rem;
            background: var(--bg-main); color: var(--text-muted);
            font-weight: 700; font-size: 0.75rem;
            text-transform: uppercase; letter-spacing: 0.05em;
            border-bottom: 1px solid var(--border-color);
        }
        .data-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
        .data-table tr:last-child td { border-bottom: none; }
        .data-table tr:hover td { background: var(--bg-main); }

        /* Status badges consistent with site.css r-badge pattern */
        .badge-active   { display:inline-flex;align-items:center;padding:2px 10px;border-radius:2px;font-size:0.72rem;font-weight:700;background:#ecfdf5;color:#059669; }
        .badge-inactive { display:inline-flex;align-items:center;padding:2px 10px;border-radius:2px;font-size:0.72rem;font-weight:700;background:#fef2f2;color:#dc2626; }
        .badge-pending  { display:inline-flex;align-items:center;padding:2px 10px;border-radius:2px;font-size:0.72rem;font-weight:700;background:#fffbeb;color:#d97706; }
        .badge-purple   { display:inline-flex;align-items:center;padding:2px 10px;border-radius:2px;font-size:0.72rem;font-weight:700;background:var(--admin-light);color:var(--admin-primary); }
        .badge-neutral  { display:inline-flex;align-items:center;padding:2px 10px;border-radius:2px;font-size:0.72rem;font-weight:700;background:#f1f5f9;color:#475569; }

        /* Page header utility */
        .page-header { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:1.75rem; }
        .page-header h1 { font-size:1.75rem; font-weight:800; color:var(--text-main); margin:0; }
        .page-header p  { color:var(--text-muted); font-size:0.95rem; margin-top:0.25rem; }

        /* KPI card purple icon variant */
        .kpi-icon.purple-bg { background: var(--admin-light); color: var(--admin-primary); }

        @@keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
        .fade-in { animation: fadeIn 0.35s ease-out; }
    </style>
    @RenderSection("Styles", required: false)
</head>
@{
    var activePage  = ViewContext.RouteData.Values["Action"]?.ToString() ?? "Index";
    var userName    = ViewBag.UserName as string ?? "Admin";
    var userHome    = ViewBag.UserHome as string ?? "/portal/admin";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "A";
}
<body>
    <partial name="_Notifications" />

    <header class="app-header">
        <div class="container nav-container">
            <a href="@userHome" class="brand-logo" style="text-decoration:none;display:flex;align-items:center;position:relative;padding-right:48px;">
                <img src="/images/logo.png" alt="Janala Logo" style="height:58px;width:auto;display:block;transform:none;transform-origin:left;" />
                <span style="position:absolute;top:-2px;right:-10px;background:var(--admin-primary);color:white;font-size:0.6rem;font-weight:900;padding:2px 6px;border-radius:2px;border:2px solid white;line-height:1;">Admin</span>
            </a>

            <nav class="desktop-nav">


                <div class="nav-dropdown" style="margin-left:0.5rem;">
                    <button class="nav-link" style="background:none;border:none;display:flex;align-items:center;gap:0.5rem;cursor:pointer;padding:0.25rem;">
                        <div style="width:36px;height:36px;border-radius:50%;background:var(--admin-primary);color:white;display:flex;align-items:center;justify-content:center;font-weight:700;">
                            @userInitial
                        </div>
                        <span style="font-weight:600;color:var(--text-main);margin-left:0.35rem;">@userName</span>
                    </button>
                    <div class="nav-dropdown-menu" style="right:0;left:auto;min-width:200px;">
                        <div class="nav-dropdown-item" style="border-bottom:1px solid var(--border-color);pointer-events:none;">
                            <span style="font-weight:700;">@userName</span>
                        </div>
                        <a href="/Auth/Logout" class="nav-dropdown-item" style="color:var(--accent-red);font-weight:700;">
                            <span>Sign Out</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <div class="app-wrapper">
        <aside class="app-sidebar">
            <ul class="sidebar-menu">

                <!-- Dashboard -->
                <li class="sidebar-item">
                    <a href="/portal/admin" class="sidebar-link @(activePage == "Index" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        Dashboard
                    </a>
                </li>

                <!-- Recruiters -->
                <li class="sidebar-item">
                    <a href="/portal/admin/Recruiters" class="sidebar-link @(activePage == "Recruiters" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Recruiters
                    </a>
                </li>

                <!-- Applicants -->
                <li class="sidebar-item">
                    <a href="/portal/admin/Applicants" class="sidebar-link @(activePage == "Applicants" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        Applicants
                    </a>
                </li>

                <!-- Add Recruiter -->
                <li class="sidebar-item">
                    <a href="/portal/admin/CreateRecruiter" class="sidebar-link @(activePage == "CreateRecruiter" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        Add Recruiter
                    </a>
                </li>

                <!-- Analytics -->
                <li class="sidebar-item">
                    <a href="/portal/admin/Analytics" class="sidebar-link @(activePage == "Analytics" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        Analytics
                    </a>
                </li>

                <!-- Revenue -->
                <li class="sidebar-item">
                    <a href="/portal/admin/Revenue" class="sidebar-link @(activePage == "Revenue" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Revenue
                    </a>
                </li>

            </ul>

            <div style="margin-top:auto;">
                <a href="/Auth/Logout" class="btn w-100" style="background:#ef4444;border-color:#ef4444;color:white;display:flex;align-items:center;justify-content:flex-start;gap:0.85rem;font-weight:600;padding:0.6rem 0.5rem;border-radius:0;">
                    <svg style="width:20px;height:20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Sign Out
                </a>
            </div>
        </aside>

        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <script src="/js/site.js"></script>
    @RenderSection("Scripts", required: false)


</body>
</html>
