@{
    var role = ViewBag.UserRole as string ?? "Applicant";
    var userName = ViewBag.UserName as string ?? "Applicant";
    var userHome = ViewBag.UserHome as string ?? "/Applicant";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "A";
    var activePage = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Applicant Portal | Janala</title>
    <meta name="description" content="Janala — AI Recruitment Platform: Applicant Portal"/>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @RenderSection("Styles", required: false)
</head>
<body>
    <partial name="_Notifications" />

    <header class="app-header">
        <div class="container nav-container">
            <a href="@userHome" class="brand-logo" style="text-decoration: none; display: flex; align-items: center; position: relative; padding-right: 48px;">
                <img src="/images/logo.png" alt="Janala Logo" style="height: 58px; width: auto; display: block; transform:none; transform-origin: left;" />
                <span style="position: absolute; top: -2px; right: -10px; background: #ef4444; color: white; font-size: 0.6rem; font-weight: 900; padding: 2px 6px; border-radius: 2px; text-transform:none; border: 2px solid white; box-shadow:none; line-height: 1;">Applicant</span>
            </a>

            <nav class="desktop-nav">
                <a href="/Applicant/BrowseJobs" class="nav-link">Find Jobs</a>
                <a href="/Applicant/RecommendedJobs" class="nav-link">Recommended</a>


                <div class="nav-dropdown user-dropdown auth-actions" style="position:relative;">
                    <button class="btn btn-outline user-dropdown-btn" id="userDropdownBtn">
                        <div class="user-avatar" style="width:36px; height:36px; border-radius:50%; background:var(--brand-primary); color:white; display:flex; align-items:center; justify-content:center; font-weight:700;">
                            @userInitial
                        </div>
                        <span style="font-weight:600; color:var(--text-main); margin-left:0.5rem;">@userName</span>

                    </button>
                    <div id="userDropdownMenu" class="auth-dropdown" style="width:220px;">
                        <a href="/Applicant/Profile" class="auth-option" style="padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem;">
                            <svg style="width:16px;height:16px;color:var(--text-muted)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span style="font-weight:600; font-size:0.95rem; color:var(--text-main);">Profile</span>
                        </a>

                        <a href="/Applicant/SavedJobs" class="auth-option" style="padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem;">
                            <svg style="width:16px;height:16px;color:var(--text-muted)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                            <span style="font-weight:600; font-size:0.95rem; color:var(--text-main);">Saved Jobs</span>
                        </a>

                        <div style="border-top:1px solid var(--border-color); margin:0.25rem 0;"></div>
                        <a href="/Auth/Logout" class="auth-option" style="padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem;">
                            <svg style="width:16px;height:16px;color:var(--accent-red)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            <span style="color:var(--accent-red); font-weight:600; font-size:0.95rem;">Sign Out</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <div class="app-wrapper">
        <aside class="app-sidebar">
            
            <ul class="sidebar-menu">
                <!-- Overview -->
                <li class="sidebar-item">
                    <a href="/Applicant" class="sidebar-link @(activePage == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Applicant" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"/></svg>
                        Dashboard
                    </a>
                </li>

                <!-- AI Precision Matcher -->
                @{ var isMatchingActive = activePage == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Matching"; }
                <li class="sidebar-item">
                    <a href="/Matching/Index" class="sidebar-link @(isMatchingActive ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        AI Job Matcher
                    </a>
                </li>

                <!-- Job Market -->
                <li class="sidebar-item">
                    <a href="/Applicant/BrowseJobs" class="sidebar-link @(activePage == "BrowseJobs" || activePage == "RecommendedJobs" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        Job Market
                    </a>
                </li>


                <!-- Job Tracker -->
                <li class="sidebar-item">
                    <a href="/Applicant/MyApplications" class="sidebar-link @(activePage == "MyApplications" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                        Job Tracker
                    </a>
                </li>

                <!-- My Profile -->
                <li class="sidebar-item">
                    <a href="/Applicant/Profile" class="sidebar-link @(activePage == "Profile" || activePage == "ProfileAnalytics" ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        My Profile
                    </a>
                </li>

                <!-- Billing & Credits -->
                @{ var isCreditsActive = ViewContext.RouteData.Values["controller"]?.ToString() == "Credits"; }
                <li class="sidebar-item">
                    <a href="/Credits/Index" class="sidebar-link @(isCreditsActive ? "active" : "")">
                        <svg style="width:16px;height:16px;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Billing & Credits
                    </a>
                </li>



            </ul>
            
            <div style="margin-top: auto;">
                <a href="/Auth/Logout" class="btn w-100" style="background:#ef4444; border-color:#ef4444; color:white; display:flex; align-items:center; justify-content:flex-start; gap:0.85rem; font-weight:600; padding:0.6rem 0.5rem; border-radius:0;">
                    <svg style="width:20px;height:20px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Sign Out
                </a>
            </div>
        </aside>

        <main class="app-content">


            @RenderBody()
        </main>
    </div>

    <script src="/js/site.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        // Sidebar Module Toggle
        function toggleSidebarModule(header) {
            const module = header.parentElement;
            const isOpen = module.classList.contains('open');
            
            // Close all other modules (Accordion style)
            document.querySelectorAll('.sidebar-module').forEach(m => {
                m.classList.remove('open');
            });
            
            // Toggle current
            if (!isOpen) {
                module.classList.add('open');
            }
        }



        // Poll unread message count for applicant
        (function() {
            function updateUnreadBadge() {
                fetch('/Applicant/UnreadMessageCount')
                    .then(r => r.ok ? r.json() : null)
                    .then(data => {
                        const badge = document.getElementById('sidebar-unread-badge');
                        const headerBadge = document.getElementById('applicant-unread-badge'); // Keeping for compatibility if needed
                        
                        if (data && data.count > 0) {
                            const countStr = data.count > 99 ? '99+' : data.count;
                            if (badge) {
                                badge.textContent = countStr;
                                badge.style.display = 'inline';
                            }
                            if (headerBadge) {
                                headerBadge.textContent = countStr;
                                headerBadge.style.display = 'inline';
                            }
                        } else {
                            if (badge) badge.style.display = 'none';
                            if (headerBadge) headerBadge.style.display = 'none';
                        }
                    })
                    .catch(() => {});
            }
            updateUnreadBadge();
            setInterval(updateUnreadBadge, 60000);
        })();
    </script>
</body>
</html>
