@{
    ViewData["Title"] = "Oops! Something Went Wrong";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="max-width: 700px; margin-top: 6rem; margin-bottom: 6rem; text-align: center;">
    <div style="background: var(--bg-white); border-radius: var(--radius-lg); border: 1px solid var(--border-color); padding: 5rem 3rem; box-shadow:none;">
        <div style="width: 80px; height: 80px; background: var(--brand-light); color: var(--brand-primary); border-radius:2px; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem; font-size: 2rem; font-weight: 800;">
            !
        </div>
        <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 1.25rem; letter-spacing: -0.02em;">System Interruption</h1>
        <p style="font-size: 1rem; color: var(--text-muted); margin-bottom: 2.5rem; line-height: 1.6; max-width: 460px; margin-left: auto; margin-right: auto;">
            Our systems encountered an unexpected technical difficulty while processing this request. The operations team has been notified for investigation.
        </p>
        
        <div style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap;">
            <a href="javascript:history.back()" class="btn btn-outline" style="padding: 0.85rem 2rem; font-size: 0.9rem; font-weight: 700; text-decoration: none; border-radius: var(--radius-md);">
                Return to Previous Page
            </a>
            <a href="/" class="btn btn-primary" style="padding: 0.85rem 2rem; font-size: 0.9rem; font-weight: 700; text-decoration: none; border-radius: var(--radius-md);">
                Back to Dashboard
            </a>
        </div>
        
        @if (ViewBag.ReturnUrl != null)
        {
            <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border-light);">
                <a href="@ViewBag.ReturnUrl" style="font-size: 0.85rem; text-decoration: none; color: var(--brand-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem;">
                    Retry last action <svg style="width: 14px; height: 14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 2v6h-6M3 12a9 9 0 0115-6.7L21 8M3 22v-6h6M21 12a9 9 0 01-15 6.7L3 16"/></svg>
                </a>
            </div>
        }
    </div>
</div>

<style>
    @@keyframes pulse {
        0% { opacity: 1; transform:none; }
        50% { opacity: 0.7; transform:none; }
        100% { opacity: 1; transform:none; }
    }
</style>
