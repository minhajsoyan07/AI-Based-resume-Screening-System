@model AIResumeScreeningSystem.DTOs.LoginDTO
@{
    ViewData["Title"] = "Applicant Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { overflow: hidden; } /* Fully remove scrollbar */
    .login-wrapper {
        height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        background: var(--bg-main);
        overflow: hidden; /* Remove scrollbar */
    }
    .login-card {
        background: white;
        width: 100%;
        max-width: 460px;
        padding: 3rem;
        border-radius: var(--radius-md);
        box-shadow:none;
        border: 1px solid var(--border-color);
    }
    .login-header { text-align: center; margin-bottom: 2rem; }
    .login-header h1 { font-size: 1.5rem; font-weight: 700; color: #001f3f; margin-bottom: 0.5rem; }
    .login-header p { color: var(--text-muted); font-size: 0.875rem; }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <div style="display: flex; justify-content: center; margin-bottom: 1.25rem;">
                <div style="width: 63px; height: 63px; background: var(--brand-light); color: var(--brand-primary); border-radius:2px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-light);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
            </div>
            <h1>Applicant Sign In</h1>
            <p>Access your career dashboard and top matches</p>
        </div>

        <form asp-action="ApplicantLogin" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; padding: 0.875rem 1rem; border-radius:2px; margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 500; display: flex; align-items: flex-start; gap: 0.75rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div asp-validation-summary="All" class="validation-summary-errors" style="list-style: none; padding: 0; margin: 0;"></div>
                </div>
            }
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" name="Email" class="form-control" placeholder="user@email.com" required />
            </div>
            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <label class="form-label" style="margin: 0;">Password</label>
                    <a href="/Auth/ForgotPassword" style="font-size: 0.8rem; color: var(--brand-primary); font-weight: 600;">Forgot?</a>
                </div>
                <div style="position: relative; display: flex; align-items: center;">
                    <input type="password" name="Password" class="form-control" placeholder="••••••••" required style="padding-right: 2.5rem;" />
                    <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: #64748b; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem; border-radius:2px; font-weight: 600; padding: 0.75rem; background: var(--brand-dark);">
                Sign In to Dashboard
            </button>
        </form>

        <div style="margin-top: 2rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
            <div>New here? <a href="/Auth/Register" style="color: var(--brand-primary); font-weight: 600;">Create an account</a></div>
            <a href="/Auth/Login" style="color: var(--text-muted); font-size: 0.8rem; display: inline-block; margin-top: 0.5rem;">← Back to role selection</a>
        </div>
    </div>
</div>
