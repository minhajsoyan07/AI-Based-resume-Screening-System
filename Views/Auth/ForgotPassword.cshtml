@model AIResumeScreeningSystem.DTOs.ForgotPasswordDTO
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { overflow: hidden; } /* Prevent body scrolling */
    .forgot-wrapper {
        height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        background: var(--bg-main);
        overflow: hidden;
    }
    .forgot-card {
        background: white;
        width: 100%;
        max-width: 460px;
        padding: 3rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-subtle);
        animation: fadeIn 0.4s ease-out forwards;
    }
    .forgot-header { text-align: center; margin-bottom: 2.25rem; }
    .forgot-header h1 { font-size: 1.5rem; font-weight: 700; color: #001f3f; margin-bottom: 0.5rem; }
    .forgot-header p { color: var(--text-muted); font-size: 0.875rem; line-height: 1.5; }
</style>

<div class="forgot-wrapper">
    <div class="forgot-card">
        <div class="forgot-header">
            <div style="display: flex; justify-content: center; margin-bottom: 1.25rem;">
                <div style="width: 63px; height: 63px; background: var(--brand-light); color: var(--brand-primary); border-radius: 2px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-light);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
            </div>
            <h1>Forgot Password</h1>
            <p>Enter your registered email address and we'll send you a link to reset your password.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 1rem; border-radius: 2px; margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: flex-start; gap: 0.75rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink: 0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div>@TempData["Success"]</div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div style="background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; padding: 1rem; border-radius: 2px; margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: flex-start; gap: 0.75rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div>@TempData["Error"]</div>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" asp-for="Email" class="form-control" placeholder="user@email.com" required autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem; border-radius: 2px; font-weight: 600; padding: 0.75rem; background: var(--brand-dark);">
                Send Reset Link
            </button>
        </form>

        <div style="margin-top: 2.25rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
            Remembered your password? <br/>
            <div style="margin-top: 0.5rem; display: flex; justify-content: center; gap: 1rem;">
                <a href="/Auth/ApplicantLogin" style="color: var(--brand-primary); font-weight: 600;">Job Seeker Login</a>
                <span style="color: var(--border-color);">|</span>
                <a href="/Auth/RecruiterLogin" style="color: var(--brand-primary); font-weight: 600;">Recruiter Login</a>
            </div>
        </div>
    </div>
</div>
