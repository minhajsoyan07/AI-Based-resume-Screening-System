@model AIResumeScreeningSystem.DTOs.ResetPasswordDTO
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { overflow: hidden; } /* Prevent body scrolling */
    .reset-wrapper {
        height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        background: var(--bg-main);
        overflow: hidden;
    }
    .reset-card {
        background: white;
        width: 100%;
        max-width: 460px;
        padding: 3rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-subtle);
        animation: fadeIn 0.4s ease-out forwards;
    }
    .reset-header { text-align: center; margin-bottom: 2.25rem; }
    .reset-header h1 { font-size: 1.5rem; font-weight: 700; color: #001f3f; margin-bottom: 0.5rem; }
    .reset-header p { color: var(--text-muted); font-size: 0.875rem; line-height: 1.5; }
</style>

<div class="reset-wrapper">
    <div class="reset-card">
        <div class="reset-header">
            <div style="display: flex; justify-content: center; margin-bottom: 1.25rem;">
                <div style="width: 63px; height: 63px; background: var(--brand-light); color: var(--brand-primary); border-radius: 2px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-light);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                </div>
            </div>
            <h1>Reset Password</h1>
            <p>Please enter your new password below. Make sure it is secure and easy to remember.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; padding: 0.875rem 1rem; border-radius: 2px; margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 500; display: flex; align-items: flex-start; gap: 0.75rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <div asp-validation-summary="All" class="validation-summary-errors" style="list-style: none; padding: 0; margin: 0;"></div>
                </div>
            }

            <input type="hidden" asp-for="Token" />

            <div class="form-group">
                <label class="form-label">New Password</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <input type="password" asp-for="Password" class="form-control" placeholder="••••••••" required style="padding-right: 2.5rem;" autofocus />
                    <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: #64748b; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required style="padding-right: 2.5rem;" />
                    <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: #64748b; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem; border-radius: 2px; font-weight: 600; padding: 0.75rem; background: var(--brand-dark);">
                Reset Password
            </button>
        </form>

        <div style="margin-top: 2.25rem; text-align: center; font-size: 0.875rem; color: var(--text-muted);">
            Back to login <br/>
            <div style="margin-top: 0.5rem; display: flex; justify-content: center; gap: 1rem;">
                <a href="/Auth/ApplicantLogin" style="color: var(--brand-primary); font-weight: 600;">Job Seeker Login</a>
                <span style="color: var(--border-color);">|</span>
                <a href="/Auth/RecruiterLogin" style="color: var(--brand-primary); font-weight: 600;">Recruiter Login</a>
            </div>
        </div>
    </div>
</div>
