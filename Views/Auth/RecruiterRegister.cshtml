@model AIResumeScreeningSystem.DTOs.RecruiterRegisterDTO
@{
    ViewData["Title"] = "Employer Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Step Styling */
    .step-section { display: none; }
    .step-section.active { display: block; }

    /* OTP Modal Styles */
    .otp-modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5);
        display: none; align-items: center; justify-content: center;
        z-index: 1000;
    }
    .otp-modal {
        background: white; padding: 2rem; border-radius:2px;
        text-align: center; width: 90%; max-width: 450px;
        position: relative;
    }
    .otp-close {
        position: absolute; top: 1rem; right: 1.5rem;
        font-size: 1.5rem; cursor: pointer; color: #888;
    }
    .otp-title { font-size: 1.25rem; color: #333; margin-bottom: 0.5rem; font-weight: 600; line-height: 1.4; }
    .otp-subtitle { color: #666; margin-bottom: 1.5rem; font-size: 0.9rem; }
    .otp-inputs { display: flex; justify-content: center; gap: 0.6rem; margin-bottom: 1.5rem; }
    .otp-input {
        width: 44px; height: 52px; font-size: 1.6rem; font-weight: 700;
        text-align: center; border: 2px solid #d1d5db; border-radius: 6px;
        color: #1e293b; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        font-family: 'Courier New', monospace; caret-color: transparent;
    }
    .otp-input:focus {
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
    }
    .otp-input.filled { border-color: #10b981; background: #f0fdf4; }
    .btn-verify { background: var(--brand-primary); color: white; border: none; padding: 0.65rem 1.5rem; font-size: 1rem; border-radius:2px; cursor: pointer; font-weight: 600; }
    .btn-verify:hover { background: var(--brand-dark); }
    

    /* Compacting Layout */
    .form-group { margin-bottom: 0.5rem !important; }
    .card-body { padding: 0.85rem 1.25rem !important; }
    .grid-cols-2, .grid-cols-3 { gap: 0.5rem !important; }
    
    .card { border-radius:2px !important; overflow: hidden; }
    .reg-card-header { background-color: var(--brand-primary) !important; border-bottom: 1px solid var(--brand-dark) !important; }
    .reg-card-header h3 { color: #ffffff !important; font-size: 1rem !important; font-weight: 700 !important; margin: 0; }

    /* Compact Upload Style */
    .input-upload-group {
        position: relative;
        display: flex;
        align-items: center;
    }
    .input-upload-group .form-control {
        padding-right: 80px;
    }
    .input-upload-group .btn-upload {
        position: absolute;
        right: 4px;
        background: #F0FDFA;
        color: var(--brand-primary);
        border: 1px solid #CCFBF1;
        padding: 4px 12px;
        border-radius:2px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        z-index: 5;
    }
    .input-upload-group input[type="file"] {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .section-title {
        font-size: 1.1rem;
        color: #333;
        font-weight: 600;
        margin: 1.5rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e5e7eb;
    }

    .tag-chip {
        background: var(--brand-light); color: var(--brand-primary); padding: 0.25rem 0.75rem; border-radius:2px;
        display: flex; align-items: center; gap: 0.25rem; font-size: 0.875rem; font-weight: 600; border: 1px solid #A7F3D0;
    }
    .tag-remove { cursor: pointer; color: #10B981; }

    /* Instant Validation States */

    /* Hide Scrollbar */
    html, body {
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
    }
    html::-webkit-scrollbar, body::-webkit-scrollbar {
        display: none; /* Chrome, Safari, and Edge */
    }
</style>

<div class="container" style="padding-top: 0; padding-bottom: 2rem; margin-top: -1rem;">
    <div class="reg-page-header">
        <h1>Employer Registration</h1>
        <p>Create your organization account to find the best talent</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert" style="background:#fef2f2; color:#ef4444; padding:0.75rem; border-radius:2px; margin-bottom:1rem; border:1px solid #fca5a5; font-size:0.9rem;">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="RecruiterRegister" method="post" id="regForm" enctype="multipart/form-data">
        
        <div id="step1" class="step-section active">
            <div class="card" style="box-shadow:none; border: 1px solid var(--border-color); padding: 0; margin-bottom: 0.75rem;">
                <div class="card-header reg-card-header">
                    <h3>Account Info</h3>
                </div>
                <div class="card-body">
                    <div class="grid-cols-3">
                        <div class="form-group">
                            <label class="form-label">User name <span class="required" style="color:red;">*</span></label>
                            <input asp-for="FullName" class="form-control check-avail" data-type="username" placeholder="Enter your user name" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Password <span class="required" style="color:red;">*</span></label>
                            <div style="position: relative; display: flex; align-items: center;">
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" minlength="6" required style="padding-right: 2.5rem;" />
                                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: #64748b; padding: 0; display: flex; align-items: center; justify-content: center;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Confirm Password <span class="required" style="color:red;">*</span></label>
                            <div style="position: relative; display: flex; align-items: center;">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Enter your confirm password" required style="padding-right: 2.5rem;" />
                                <button type="button" onclick="togglePasswordVisibility(this)" style="position: absolute; right: 10px; background: none; border: none; cursor: pointer; color: #64748b; padding: 0; display: flex; align-items: center; justify-content: center;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card" style="box-shadow:none; border: 1px solid var(--border-color); padding: 0;">
                <div class="card-header reg-card-header">
                    <h3>Contact Person's Info</h3>
                </div>
                <div class="card-body" style="padding: 1.25rem 1.5rem;">
                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Name <span class="required" style="color:red;">*</span></label>
                            <input asp-for="ContactName" class="form-control" placeholder="Enter your name" required />
                            <span asp-validation-for="ContactName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Designation <span class="required" style="color:red;">*</span></label>
                            <input asp-for="Designation" class="form-control" placeholder="Enter your designation" required />
                            <span asp-validation-for="Designation" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="grid-cols-2" style="margin-top: 0.25rem;">
                        <div class="form-group">
                            <label class="form-label">Email <span class="required" style="color:red;">*</span></label>
                            <input asp-for="Email" type="email" class="form-control check-avail" data-type="email" placeholder="Enter your email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Mobile number <span class="required" style="color:red;">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control check-avail" data-type="phone" placeholder="01XXXXXXXXX" pattern="^01[3-9]\d{8}$" maxlength="11" oninput="this.value = this.value.replace(/[^0-9]/g, '');" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <div style="padding: 0.5rem 1.25rem 1rem 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                    <a href="@Url.Action("Index", "Home")" style="color: var(--brand-primary); text-decoration: none; font-size: 0.9rem;">Already have an account? Sign In</a>
                    <button type="button" class="btn btn-primary" style="padding: 0.6rem 2rem; background: var(--brand-primary); border-radius:2px; font-weight: 600;" onclick="showOtp()">Next</button>
                </div>
            </div>
        </div>

        <div id="step3" class="step-section">
            <div class="card" style="box-shadow:none; border: 1px solid var(--border-color); padding: 0;">
                <div class="card-header reg-card-header">
                    <h3>Organization Info</h3>
                </div>
                <div class="card-body">
                    
                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Name of the organization <span class="required" style="color:red;">*</span></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Enter your organization name" required />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Name of the organization (Bangla) <span class="required" style="color:red;">*</span></label>
                            <input asp-for="CompanyNameBangla" class="form-control" placeholder="Enter your organization name(bangla)" required />
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Organization category <span class="required" style="color:red;">*</span></label>
                            <select asp-for="OrganizationCategory" class="form-control" required>
                                <option value="">Select category</option>
                                <option value="Government">Government</option>
                                <option value="Semi Government">Semi Government</option>
                                <option value="Private Firm">Private Firm</option>
                                <option value="NGO">NGO/Development Sector</option>
                                <option value="International">International Organization</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Industry Type <span class="required" style="color:red;">*</span></label>
                            <select asp-for="IndustryType" class="form-control" required>
                                <option value="">Select industry type</option>
                                <option value="IT">IT & Software</option>
                                <option value="Education">Education/Research</option>
                                <option value="Finance">Finance/Banking</option>
                                <option value="Healthcare">Healthcare/Medical</option>
                                <option value="Manufacturing">Manufacturing/Garments</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Website address</label>
                            <input asp-for="CompanyWebsite" class="form-control" placeholder="Website address" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Organization tags</label>
                            <div class="tag-input-container" style="min-height: 40px; display:flex; flex-wrap:wrap; gap:0.5rem; padding:0.4rem; border:1px solid #d1d5db; border-radius:2px; align-items:center;">
                                <div id="tags-wrapper" style="display:flex; gap:0.4rem; flex-wrap:wrap;"></div>
                                <input type="text" id="tagger" placeholder="Type and press enter" style="border:none; outline:none; font-size:0.9rem; flex:1;" />
                            </div>
                            <input type="hidden" asp-for="Tags" id="hidden-tags" />
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Organization tagline</label>
                            <input asp-for="Tagline" class="form-control" placeholder="Enter your organization tagline" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Logo <span class="required" style="color:red;">*</span></label>
                            <div class="input-upload-group">
                                <input type="text" class="form-control" placeholder="Upload your logo" id="logoText" readonly />
                                <button type="button" class="btn-upload">Upload</button>
                                <input asp-for="LogoFile" type="file" accept="image/*" required onchange="document.getElementById('logoText').value = this.files[0].name" />
                            </div>
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Cover photo</label>
                            <div class="input-upload-group">
                                <input type="text" class="form-control" placeholder="Upload cover photo" id="coverText" readonly />
                                <button type="button" class="btn-upload">Upload</button>
                                <input asp-for="CoverPhotoFile" type="file" accept="image/*" onchange="document.getElementById('coverText').value = this.files[0].name" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Signature</label>
                            <div class="input-upload-group">
                                <input type="text" class="form-control" placeholder="Upload signature" id="sigText" readonly />
                                <button type="button" class="btn-upload">Upload</button>
                                <input asp-for="SignatureFile" type="file" accept="image/*" onchange="document.getElementById('sigText').value = this.files[0].name" />
                            </div>
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Establishment year <span class="required" style="color:red;">*</span></label>
                            <input asp-for="EstablishmentYear" type="number" class="form-control" placeholder="YYYY" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Organization size</label>
                            <select asp-for="CompanySize" class="form-control">
                                <option value="">Select size</option>
                                <option value="1-10">1-10 employees</option>
                                <option value="11-50">11-50 employees</option>
                                <option value="51-200">51-200 employees</option>
                                <option value="200+">200+ employees</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Organization email <span class="required" style="color:red;">*</span></label>
                        <input asp-for="OrganizationEmail" class="form-control" placeholder="Enter your organization email" required />
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">About Organization <span class="required" style="color:red;">*</span></label>
                            <textarea asp-for="AboutOrganization" class="form-control" rows="2" placeholder="About your organization" required></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Vision of the organization <span class="required" style="color:red;">*</span></label>
                            <textarea asp-for="Vision" class="form-control" rows="2" placeholder="Your vision" required></textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mission of the organization <span class="required" style="color:red;">*</span></label>
                        <textarea asp-for="Mission" class="form-control" rows="2" placeholder="Your mission" required></textarea>
                    </div>
                </div>
            </div>

            <!-- Location Section -->
            <div class="card" style="box-shadow:none; border: 1px solid var(--border-color); padding: 0; margin-top: 0.75rem;">
                <div class="card-header reg-card-header">
                    <h3>Location Info</h3>
                </div>
                <div class="card-body">
                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Division <span class="required" style="color:red;">*</span></label>
                            <select asp-for="Division" id="divSelect" class="form-control" required>
                                <option value="">Select division</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">District <span class="required" style="color:red;">*</span></label>
                            <select asp-for="District" id="distSelect" class="form-control" required disabled>
                                <option value="">Select district</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Thana <span class="required" style="color:red;">*</span></label>
                            <select asp-for="Thana" id="thanaSelect" class="form-control" required disabled>
                                <option value="">Select thana</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Postal code <span class="required" style="color:red;">*</span></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Postal code" required />
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Organization full address <span class="required" style="color:red;">*</span></label>
                            <textarea asp-for="FullAddress" class="form-control" rows="2" placeholder="Full address" required></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Full address in bangla <span class="required" style="color:red;">*</span></label>
                            <textarea asp-for="FullAddressBangla" class="form-control" rows="2" placeholder="পূর্ণ ঠিকানা বাংলা" required></textarea>
                        </div>
                    </div>

                    <div class="grid-cols-2">
                        <div class="form-group">
                            <label class="form-label">Organization mobile number <span class="required" style="color:red;">*</span></label>
                            <input asp-for="OrganizationMobile" class="form-control" placeholder="Organization mobile" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Organization land phone</label>
                            <input asp-for="LandPhoneNumber" class="form-control" placeholder="Land phone number" />
                        </div>
                    </div>

                    <div style="margin-top: 1.5rem; text-align: right;">
                        <button type="submit" class="btn btn-primary" style="padding: 0.7rem 2.5rem; background: var(--brand-primary); font-weight: 700; border-radius:2px; border: none;">SAVE CHANGE</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- OTP Modal -->
        <div class="otp-modal-overlay" id="otpModal">
            <div class="otp-modal">
                <div class="otp-close" onclick="closeOtp()">✕</div>
                <div class="otp-title">Verify Your Email</div>
                <div class="otp-subtitle">We have sent a 6-digit OTP to your email.</div>
                
                <div class="otp-inputs" id="otpBoxes">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp0">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp1">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp2">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp3">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp4">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" id="otp5">
                </div>

                <div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem;">
                    <span style="color:#666; cursor:pointer; font-size:0.9rem;" onclick="showOtp()">Resend OTP</span>
                    <button type="button" class="btn-verify" onclick="verifyOtpAndProceed()">Verify</button>
                </div>
            </div>
        </div>
    </form>
</div>

